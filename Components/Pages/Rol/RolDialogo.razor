@using ExploreWayApp.DTOs.Estado
@using ExploreWayApp.DTOs.Rol

<MudDialog Class="exploreway-destino-dialogo">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Style="color: var(--ew-primary);" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                @(EsEdicion ? "Editar rol" : "Nuevo rol")
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_formulario" Model="modelo">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Nombre del rol"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Counter="50"
                                  MaxLength="50"
                                  @bind-Value="modelo.NombreRol"
                                  For="@(() => modelo.NombreRol)" />
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int?"
                               Label="Estado"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter"
                               @bind-Value="modelo.IdEstado"
                               For="@(() => modelo.IdEstado)">
                        @foreach (var estado in Estados)
                        {
                            <MudSelectItem T="int?" Value="@estado.IdEstado">@estado.NombreEstado</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Class="text-none" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled"
                   Class="rounded-pill px-6 text-none exploreway-btn-auth"
                   OnClick="GuardarAsync">
            Guardar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    // Rol a editar; null significa que se está creando uno nuevo.
    [Parameter] public RolSalida? RolEditar { get; set; }
    [Parameter] public List<EstadoSalida> Estados { get; set; } = [];

    private readonly RolGuardar modelo = new();
    private MudForm _formulario = default!;

    private bool EsEdicion => RolEditar is not null;

    protected override void OnInitialized()
    {
        if (RolEditar is null) return;

        modelo.NombreRol = RolEditar.NombreRol;
        modelo.IdEstado = RolEditar.IdEstado;
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task GuardarAsync()
    {
        await _formulario.ValidateAsync();
        if (!_formulario.IsValid) return;

        modelo.NombreRol = modelo.NombreRol.Trim();

        MudDialog.Close(DialogResult.Ok(modelo));
    }
}