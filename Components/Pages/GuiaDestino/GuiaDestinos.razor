@page "/admin/guia-destinos"
@layout AdminLayout

@using Microsoft.AspNetCore.Components.Authorization
@using ExploreWayApp.DTOs.Comun
@using ExploreWayApp.DTOs.GuiaDestino
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Servicios.GuiaDestino
@using ExploreWayApp.Servicios.Estado

@inject IGuiaDestinoService GuiaDestinoService
@inject IEstadoService EstadoService
@inject IDialogService Dialogos
@inject ISnackbar Snackbar

<PageTitle>Destinos por guía — ExploreWay</PageTitle>

<div class="exploreway-admin">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 px-md-8">

        <AuthorizeView>
            <NotAuthorized>
                <div class="exploreway-admin-vacio">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Style="color: var(--ew-primary);" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold mt-3">Iniciá sesión para gestionar las asignaciones</MudText>
                    <MudText Typo="Typo.body2" Class="mb-5" Style="color: #64748b;">
                        Esta sección es solo para usuarios autenticados.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Href="/login" Class="rounded-pill px-6 text-none exploreway-btn-auth">
                        Iniciar sesión
                    </MudButton>
                </div>
            </NotAuthorized>

            <Authorized Context="_auth">
                <header class="exploreway-admin-head">
                    <div>
                        <span class="exploreway-admin-kicker">Operación · @_asignaciones.Count asignaciones</span>
                        <MudText Typo="Typo.h3" Class="font-weight-bold exploreway-section-title">Destinos por guía</MudText>
                        <MudText Typo="Typo.body1" Class="exploreway-section-lead">
                            Indicá en qué destinos trabaja cada guía.
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Add"
                               Class="rounded-pill px-6 py-2 text-none exploreway-btn-auth"
                               Disabled="cargando"
                               OnClick="NuevoAsync">
                        Asignar destino
                    </MudButton>
                </header>

                <div class="exploreway-admin-filtros">
                    <MudTextField @bind-Value="_busqueda"
                                  Placeholder="Buscar por guía o destino"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  AdornmentColor="Color.Primary"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="exploreway-admin-buscar" />

                    <MudChipSet T="int?" @bind-SelectedValue="_filtroEstado" SelectionMode="SelectionMode.SingleSelection"
                                CheckMark="false">
                        <MudChip T="int?" Value="@((int?)null)" Default="true" Variant="Variant.Outlined" Color="Color.Primary">
                            Todos
                        </MudChip>
                        @foreach (var estado in _estados)
                        {
                            <MudChip T="int?" Value="@estado.IdEstado" Variant="Variant.Outlined" Color="Color.Primary">
                                @estado.NombreEstado
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                @if (error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Style="border-radius: 12px;"
                              ContentAlignment="HorizontalAlignment.Start">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                            <span>@error</span>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                       Class="text-none" OnClick="CargarAsync">
                                Reintentar
                            </MudButton>
                        </div>
                    </MudAlert>
                }

                <MudTable Items="Filtrados"
                          Loading="cargando"
                          LoadingProgressColor="Color.Primary"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Elevation="0"
                          RowsPerPage="10"
                          Class="exploreway-admin-tabla">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel T="GuiaDestinoSalida" SortBy="g => g.NombreGuia + g.ApellidoGuia" InitialDirection="SortDirection.Ascending">Guía</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="GuiaDestinoSalida" SortBy="g => g.NombreDestino">Destino</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="GuiaDestinoSalida" SortBy="g => g.NombreEstado">Estado</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align: right;">Acciones</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Guía">
                            <div class="exploreway-admin-nombre">@NombreGuia(context)</div>
                        </MudTd>
                        <MudTd DataLabel="Destino">
                            <div class="exploreway-admin-nombre">@context.NombreDestino</div>
                            @if (!string.IsNullOrWhiteSpace(Ubicacion(context)))
                            {
                                <div class="exploreway-admin-desc">@Ubicacion(context)</div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="@ColorEstado(context.NombreEstado)" Class="ma-0">
                                @(string.IsNullOrWhiteSpace(context.NombreEstado) ? $"Estado {context.IdEstado}" : context.NombreEstado)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align: right; white-space: nowrap;">
                            @if (EsActivo(context))
                            {
                                <MudTooltip Text="Suspender">
                                    <MudIconButton Icon="@Icons.Material.Outlined.PauseCircle" Size="Size.Small" Color="Color.Warning"
                                                   aria-label="@($"Suspender a {NombreGuia(context)} en {context.NombreDestino}")"
                                                   OnClick="@(() => AlternarEstadoAsync(context))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="Reactivar">
                                    <MudIconButton Icon="@Icons.Material.Outlined.PlayCircle" Size="Size.Small" Color="Color.Success"
                                                   aria-label="@($"Reactivar a {NombreGuia(context)} en {context.NombreDestino}")"
                                                   OnClick="@(() => AlternarEstadoAsync(context))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="Eliminar">
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                               aria-label="@($"Eliminar asignación de {NombreGuia(context)} en {context.NombreDestino}")"
                                               OnClick="@(() => EliminarAsync(context))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>

                    <NoRecordsContent>
                        <div class="exploreway-admin-vacio">
                            <MudIcon Icon="@Icons.Material.Outlined.Hiking" Size="Size.Large" Style="color: var(--ew-teal);" />
                            @if (_asignaciones.Count == 0)
                            {
                                <MudText Typo="Typo.h6" Class="font-weight-bold mt-2">Todavía no hay asignaciones</MudText>
                                <MudText Typo="Typo.body2" Style="color: #64748b;">Creá la primera con el botón “Asignar destino”.</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.h6" Class="font-weight-bold mt-2">Sin resultados</MudText>
                                <MudText Typo="Typo.body2" Style="color: #64748b;">Ninguna asignación coincide con los filtros aplicados.</MudText>
                            }
                        </div>
                    </NoRecordsContent>

                    <LoadingContent>
                        <MudText Typo="Typo.body2" Class="pa-6" Style="color: #64748b;">Cargando asignaciones…</MudText>
                    </LoadingContent>

                    <PagerContent>
                        <MudTablePager RowsPerPageString="Filas por página:"
                                       InfoFormat="{first_item}-{last_item} de {all_items}"
                                       PageSizeOptions="new[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudTable>
            </Authorized>
        </AuthorizeView>
    </MudContainer>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> EstadoAuth { get; set; } = default!;

    private List<GuiaDestinoSalida> _asignaciones = [];
    private List<EstadoSalida> _estados = [];
    private string _busqueda = string.Empty;
    private int? _filtroEstado;
    private bool cargando;
    private string? error;

    private IEnumerable<GuiaDestinoSalida> Filtrados => _asignaciones.Where(a =>
        (_filtroEstado is null || a.IdEstado == _filtroEstado) &&
        (string.IsNullOrWhiteSpace(_busqueda) ||
         Contiene(a.NombreGuia) || Contiene(a.ApellidoGuia) || Contiene(NombreGuia(a)) ||
         Contiene(a.NombreDestino) || Contiene(a.Departamento) || Contiene(a.Municipio)));

    private bool Contiene(string? texto) =>
        texto?.Contains(_busqueda.Trim(), StringComparison.OrdinalIgnoreCase) == true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await EstadoAuth;
        if (auth.User.Identity?.IsAuthenticated == true)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        try
        {
            _asignaciones = await GuiaDestinoService.ListarAsync();
            _estados = await CargarEstadosAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }

    // Si el catálogo no está disponible, se arma con los estados que traen las asignaciones.
    private async Task<List<EstadoSalida>> CargarEstadosAsync()
    {
        try
        {
            var estados = await EstadoService.ListarPorTipoAsync("General");
            if (estados.Count > 0) return estados;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { }

        return _asignaciones
            .GroupBy(a => a.IdEstado)
            .Select(g => new EstadoSalida
            {
                IdEstado = g.Key,
                NombreEstado = string.IsNullOrWhiteSpace(g.First().NombreEstado) ? $"Estado {g.Key}" : g.First().NombreEstado
            })
            .OrderBy(e => e.NombreEstado)
            .ToList();
    }

    private static string NombreGuia(GuiaDestinoSalida a) => $"{a.NombreGuia} {a.ApellidoGuia}".Trim();

    private static string Ubicacion(GuiaDestinoSalida a) =>
        string.IsNullOrWhiteSpace(a.Municipio)
            ? a.Departamento ?? string.Empty
            : string.IsNullOrWhiteSpace(a.Departamento) ? a.Municipio : $"{a.Municipio}, {a.Departamento}";

    private static bool EsActivo(GuiaDestinoSalida a) =>
        string.Equals(a.NombreEstado?.Trim(), "Activo", StringComparison.OrdinalIgnoreCase);

    private static Color ColorEstado(string? estado) => estado?.Trim().ToLowerInvariant() switch
    {
        "activo" => Color.Success,
        "inactivo" => Color.Error,
        null or "" => Color.Default,
        _ => Color.Info
    };

    private async Task NuevoAsync()
    {
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

        var dialogo = await Dialogos.ShowAsync<GuiaDestinoDialogo>((string?)null, opciones);
        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled) return;

        Snackbar.Add("Destino asignado al guía.", Severity.Success);
        await CargarAsync();
    }

    private async Task AlternarEstadoAsync(GuiaDestinoSalida asignacion)
    {
        var activar = !EsActivo(asignacion);
        var objetivo = _estados.FirstOrDefault(e =>
            string.Equals(e.NombreEstado?.Trim(), activar ? "Activo" : "Inactivo", StringComparison.OrdinalIgnoreCase));

        if (objetivo is null)
        {
            Snackbar.Add("No se encontró el estado requerido en el catálogo.", Severity.Warning);
            return;
        }

        var accion = activar ? "reactivar" : "suspender";
        var confirmar = await Dialogos.ShowMessageBoxAsync(
            activar ? "Reactivar asignación" : "Suspender asignación",
            $"¿Querés {accion} a {NombreGuia(asignacion)} en “{asignacion.NombreDestino}”?",
            yesText: activar ? "Reactivar" : "Suspender", cancelText: "Cancelar");
        if (confirmar != true) return;

        try
        {
            await GuiaDestinoService.ModificarAsync(asignacion.IdGuiaDestino,
                new CambioEstadoModificar { IdEstado = objetivo.IdEstado });
            Snackbar.Add(activar ? "Asignación reactivada." : "Asignación suspendida.", Severity.Success);
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo conectar con el servidor.", Severity.Error);
        }
    }

    private async Task EliminarAsync(GuiaDestinoSalida asignacion)
    {
        var confirmar = await Dialogos.ShowMessageBoxAsync(
            "Eliminar asignación",
            $"¿Seguro que querés quitar “{asignacion.NombreDestino}” a {NombreGuia(asignacion)}? Esta acción no se puede deshacer.",
            yesText: "Eliminar", cancelText: "Cancelar");
        if (confirmar != true) return;

        try
        {
            await GuiaDestinoService.EliminarAsync(asignacion.IdGuiaDestino);
            _asignaciones.Remove(asignacion);
            Snackbar.Add("Asignación eliminada.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo conectar con el servidor.", Severity.Error);
        }
    }
}
