@page "/explorar"
@page "/cliente/destinos"

@using System.Globalization
@using ExploreWayApp.Auth
@using ExploreWayApp.DTOs.Destino
@using ExploreWayApp.DTOs.DestinoActividad
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Servicios.Destino
@using ExploreWayApp.Servicios.DestinoActividad
@using ExploreWayApp.Servicios.ImagenDestino

@inject IDestinoService DestinoService
@inject IDestinoActividadService DestinoActividadService
@inject IImagenDestinoService ImagenService
@inject SesionUsuario Sesion

<PageTitle>Destinos — ExploreWay</PageTitle>

<div class="ex-pagina">
    <header class="ex-cabecera">
        <div class="ex-contenedor">
            <h1 class="ex-titulo">Destinos</h1>
            <p class="ex-bajada">
                Recorré los lugares que tenemos para vos. Mirá actividades, precios y guías sin necesidad de una cuenta.
            </p>

            <div class="ex-herramientas">
                <div class="ex-buscar" role="search">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                    <input type="search" aria-label="Buscar destinos" placeholder="Buscar por nombre o lugar"
                           value="@_busqueda" @oninput="e => _busqueda = e.Value?.ToString() ?? string.Empty" />
                    @if (!string.IsNullOrEmpty(_busqueda))
                    {
                        <button type="button" aria-label="Borrar búsqueda" @onclick="() => _busqueda = string.Empty">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    }
                </div>

                @if (Departamentos.Count > 1)
                {
                    <div class="ex-filtros" role="group" aria-label="Filtrar por departamento">
                        <button type="button" class="ex-chip" aria-pressed="@(_depto is null ? "true" : "false")" @onclick="() => _depto = null">Todos</button>
                        @foreach (var dep in Departamentos)
                        {
                            var valor = dep;
                            <button type="button" class="ex-chip" aria-pressed="@(_depto == valor ? "true" : "false")"
                                    @onclick="() => _depto = (_depto == valor ? null : valor)">@valor</button>
                        }
                    </div>
                }
            </div>
        </div>
    </header>

    <div class="ex-cuerpo">
        <div class="ex-contenedor">
            @if (error is not null)
            {
                <div class="ex-aviso" role="alert">
                    <span>@error</span>
                    <button type="button" class="ex-btn ex-btn--linea ex-btn--sm" @onclick="CargarAsync">Reintentar</button>
                </div>
            }

            @if (cargando)
            {
                <div class="ex-grilla" aria-busy="true" aria-label="Cargando destinos">
                    @for (var i = 0; i < 6; i++)
                    {
                        <div class="ex-esqueleto"></div>
                    }
                </div>
            }
            else if (!Filtrados.Any() && error is null)
            {
                <div class="ex-vacio">
                    <MudIcon Icon="@Icons.Material.Outlined.TravelExplore" Size="Size.Large" Style="color: var(--ew-green-ink);" />
                    <h2>@(_destinos.Count == 0 ? "Todavía no hay destinos disponibles" : "No encontramos destinos con ese filtro")</h2>
                    <p>@(_destinos.Count == 0 ? "Estamos preparando nuevas expediciones. Volvé pronto." : "Probá con otro nombre o quitá el filtro de departamento.")</p>
                    @if (_destinos.Count > 0)
                    {
                        <button type="button" class="ex-btn ex-btn--primario" @onclick="LimpiarFiltros">Ver todos los destinos</button>
                    }
                </div>
            }
            else if (Filtrados.Any())
            {
                var lista = Filtrados.ToList();
                var hayFiltro = !string.IsNullOrWhiteSpace(_busqueda) || _depto is not null;

                <p class="ex-conteo" aria-live="polite">@lista.Count @(lista.Count == 1 ? "destino" : "destinos")</p>

                <div class="ex-grilla">
                    @for (var i = 0; i < lista.Count; i++)
                    {
                        var d = lista[i];
                        var ofertas = _ofertas.TryGetValue(d.IdDestino, out var of) ? of : [];
                        var destacada = i == 0 && !hayFiltro && lista.Count >= 4;
                        <a class="ex-tarjeta @(destacada ? "ex-tarjeta--destacada" : "")" style="--i:@i" href="/explorar/@d.IdDestino">
                            <div class="ex-tarjeta-media">
                                @if (_imagenes.TryGetValue(d.IdDestino, out var url) && !string.IsNullOrWhiteSpace(url))
                                {
                                    <img src="@url" alt="" loading="@(i < 3 ? "eager" : "lazy")" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Outlined.Landscape" Size="Size.Large" />
                                }
                                <span class="ex-ubicacion">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />@Ubicacion(d)
                                </span>
                            </div>
                            <div class="ex-tarjeta-cuerpo">
                                <h2 class="ex-tarjeta-nombre">@d.Nombre</h2>
                                @if (!string.IsNullOrWhiteSpace(d.Descripcion))
                                {
                                    <p class="ex-tarjeta-desc">@d.Descripcion</p>
                                }
                                <div class="ex-tarjeta-pie">
                                    <span class="ex-desde">
                                        @if (ofertas.Count > 0)
                                        {
                                            <text>@ofertas.Count @(ofertas.Count == 1 ? "actividad" : "actividades") · desde <b>@Precio(ofertas.Min(o => o.PrecioBase))</b></text>
                                        }
                                        else
                                        {
                                            <text>Sin actividades por ahora</text>
                                        }
                                    </span>
                                    <span class="ex-flecha" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }

            @if (!cargando && !Sesion.Autenticado)
            {
                <section class="ex-invitacion" aria-labelledby="ex-inv">
                    <div>
                        <h2 id="ex-inv">¿Ya elegiste tu próxima salida?</h2>
                        <p>Explorar es libre. Para reservar una actividad con un guía necesitás una cuenta gratuita.</p>
                    </div>
                    <div class="ex-invitacion-acciones">
                        <a class="ex-btn ex-btn--verde" href="/registro?returnUrl=%2Fexplorar">Crear cuenta</a>
                        <a class="ex-btn ex-btn--claro" href="/login?returnUrl=%2Fexplorar">Iniciar sesión</a>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

@code {
    private List<DestinoSalidaDto> _destinos = [];
    private Dictionary<int, List<DestinoActividadSalida>> _ofertas = [];
    private Dictionary<int, string?> _imagenes = [];
    private string _busqueda = string.Empty;
    private string? _depto;
    private bool cargando = true;
    private string? error;

    private List<string> Departamentos => _destinos
        .Select(d => d.Departamento)
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct()
        .OrderBy(d => d)
        .ToList();

    private IEnumerable<DestinoSalidaDto> Filtrados => _destinos.Where(d =>
        (_depto is null || d.Departamento == _depto) &&
        (string.IsNullOrWhiteSpace(_busqueda) || Contiene(d.Nombre) || Contiene(d.Departamento) || Contiene(d.Municipio)));

    private bool Contiene(string? texto) =>
        texto?.Contains(_busqueda.Trim(), StringComparison.OrdinalIgnoreCase) == true;

    private void LimpiarFiltros()
    {
        _busqueda = string.Empty;
        _depto = null;
    }

    private static bool Activo(string? estado) =>
        string.Equals(estado?.Trim(), "Activo", StringComparison.OrdinalIgnoreCase);

    private static string Ubicacion(DestinoSalidaDto d) =>
        string.IsNullOrWhiteSpace(d.Municipio) ? d.Departamento : $"{d.Municipio}, {d.Departamento}";

    private static string Precio(decimal valor) => valor.ToString("C2", CultureInfo.GetCultureInfo("en-US"));

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        try
        {
            _destinos = (await DestinoService.ListarAsync())
                .Where(d => Activo(d.NombreEstado))
                .OrderBy(d => d.Nombre)
                .ToList();

            // Las actividades (conteo y precio "desde") son un extra: si un destino no las devuelve, se muestra igual.
            var ofertas = await Task.WhenAll(_destinos.Select(async d =>
            {
                try
                {
                    var lista = (await DestinoActividadService.ListarPorDestinoAsync(d.IdDestino))
                        .Where(o => Activo(o.NombreEstado))
                        .ToList();
                    return (d.IdDestino, Lista: lista);
                }
                catch (Exception ex) when (ex is ApiException or HttpRequestException)
                {
                    return (d.IdDestino, Lista: new List<DestinoActividadSalida>());
                }
            }));
            _ofertas = ofertas.ToDictionary(o => o.IdDestino, o => o.Lista);

            var principales = await Task.WhenAll(_destinos.Select(async d =>
            {
                try
                {
                    var imagenes = await ImagenService.ListarPorDestinoAsync(d.IdDestino);
                    return (d.IdDestino, Url: (imagenes.FirstOrDefault(i => i.EsPrincipal) ?? imagenes.FirstOrDefault())?.UrlImagen);
                }
                catch (Exception ex) when (ex is ApiException or HttpRequestException)
                {
                    return (d.IdDestino, Url: (string?)null);
                }
            }));
            _imagenes = principales.ToDictionary(p => p.IdDestino, p => p.Url);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }
}
