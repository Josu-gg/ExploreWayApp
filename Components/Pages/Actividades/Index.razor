@* Components/Pages/Actividades/Index.razor *@
@using ExploreWayApp.DTOs.actividad
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Servicios.actividad
@using ExploreWayApp.Servicios.Estado
@layout AdminLayout
@page "/actividades"
@inject IActividadService ActividadService
@inject IEstadoService EstadoService

<PageTitle>Actividades</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Actividades</h3>
    <a class="btn btn-primary" href="actividades/nueva">Nueva actividad</a>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    </div>
}
else if (resultado is null || resultado.Contenido.Count == 0)
{
    <div class="alert alert-info">No hay actividades registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Dificultad</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in resultado.Contenido)
                {
                    <tr>
                        <td>@a.Nombre</td>
                        <td class="text-truncate" style="max-width: 320px;">@(a.Descripcion ?? "—")</td>
                        <td>@(a.Dificultad ?? "—")</td>
                        <td><span class="badge text-bg-secondary">@estados.GetValueOrDefault(a.IdEstado, "—")</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="actividades/editar/@a.IdActividad">Editar</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => actividadAEliminar = a">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-muted">@resultado.TotalElementos registros</span>

        <ul class="pagination mb-0">
            <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => IrAPaginaAsync(paginaActual - 1)">Anterior</button>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Página @paginaActual de @Math.Max(resultado.TotalPaginas, 1)</span>
            </li>
            <li class="page-item @(paginaActual >= resultado.TotalPaginas ? "disabled" : "")">
                <button class="page-link" @onclick="() => IrAPaginaAsync(paginaActual + 1)">Siguiente</button>
            </li>
        </ul>

        <select class="form-select w-auto" value="@tamano" @onchange="CambiarTamanoAsync">
            @foreach (var t in tamanos)
            {
                <option value="@t">@t por página</option>
            }
        </select>
    </div>
}

@if (actividadAEliminar is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar actividad</h5>
                </div>
                <div class="modal-body">
                    ¿Seguro que deseas eliminar <strong>@actividadAEliminar.Nombre</strong>?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" disabled="@eliminando" @onclick="() => actividadAEliminar = null">Cancelar</button>
                    <button class="btn btn-danger" disabled="@eliminando" @onclick="EliminarAsync">
                        @(eliminando ? "Eliminando..." : "Eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly int[] tamanos = [5, 10, 20];

    private PaginaResultado<ActividadSalida>? resultado;
    private Dictionary<int, string> estados = [];
    private ActividadSalida? actividadAEliminar;
    private string? error;
    private int paginaActual = 1;
    private int tamano = 10;
    private bool cargando = true;
    private bool eliminando;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            estados = (await EstadoService.ListarAsync()).ToDictionary(e => e.IdEstado, e => e.NombreEstado);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        try
        {
            resultado = await ActividadService.ListarAsync(paginaActual, tamano);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task IrAPaginaAsync(int pagina)
    {
        paginaActual = pagina;
        await CargarAsync();
    }

    private async Task CambiarTamanoAsync(ChangeEventArgs e)
    {
        tamano = int.Parse(e.Value!.ToString()!);
        paginaActual = 1;
        await CargarAsync();
    }

    private async Task EliminarAsync()
    {
        if (actividadAEliminar is null) return;

        eliminando = true;
        try
        {
            await ActividadService.EliminarAsync(actividadAEliminar.IdActividad);
            actividadAEliminar = null;

            if (resultado is { Contenido.Count: 1 } && paginaActual > 1)
                paginaActual--;

            await CargarAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            actividadAEliminar = null;
        }
        finally
        {
            eliminando = false;
        }
    }
}