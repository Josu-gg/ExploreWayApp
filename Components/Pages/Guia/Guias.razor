@page "/admin/guias"
@layout AdminLayout

@using Microsoft.AspNetCore.Components.Authorization
@using ExploreWayApp.DTOs.guia
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Servicios.Guia
@using ExploreWayApp.Servicios.Estado

@inject IGuiaService GuiaService
@inject IEstadoService EstadoService
@inject IDialogService Dialogos
@inject ISnackbar Snackbar

<PageTitle>Guías — ExploreWay</PageTitle>

<div class="exploreway-admin">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 px-md-8">

        <AuthorizeView>
            <NotAuthorized>
                <div class="exploreway-admin-vacio">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Style="color: var(--ew-primary);" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold mt-3">Iniciá sesión para gestionar guías</MudText>
                    <MudText Typo="Typo.body2" Class="mb-5" Style="color: #64748b;">
                        Esta sección es solo para usuarios autenticados.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Href="/login" Class="rounded-pill px-6 text-none exploreway-btn-auth">
                        Iniciar sesión
                    </MudButton>
                </div>
            </NotAuthorized>

            <Authorized Context="_auth">
                @* ENCABEZADO *@
                <header class="exploreway-admin-head">
                    <div>
                        <span class="exploreway-admin-kicker">Equipo · @_guias.Count registrados</span>
                        <MudText Typo="Typo.h3" Class="font-weight-bold exploreway-section-title">Guías</MudText>
                        <MudText Typo="Typo.body1" Class="exploreway-section-lead">
                            Administrá a las personas que acompañan las expediciones de ExploreWay.
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Add"
                               Class="rounded-pill px-6 py-2 text-none exploreway-btn-auth"
                               Disabled="cargando"
                               OnClick="NuevoAsync">
                        Nuevo guía
                    </MudButton>
                </header>

                @* BARRA DE FILTROS *@
                <div class="exploreway-admin-filtros">
                    <MudTextField @bind-Value="_busqueda"
                                  Placeholder="Buscar por nombre o apellido"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  AdornmentColor="Color.Primary"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="exploreway-admin-buscar" />

                    <MudChipSet T="int?" @bind-SelectedValue="_filtroEstado" SelectionMode="SelectionMode.SingleSelection"
                                CheckMark="false">
                        <MudChip T="int?" Value="@((int?)null)" Default="true" Variant="Variant.Outlined" Color="Color.Primary">
                            Todos
                        </MudChip>
                        @foreach (var estado in _estados)
                        {
                            <MudChip T="int?" Value="@estado.IdEstado" Variant="Variant.Outlined" Color="Color.Primary">
                                @estado.NombreEstado
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                @if (error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Style="border-radius: 12px;"
                              ContentAlignment="HorizontalAlignment.Start">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                            <span>@error</span>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                       Class="text-none" OnClick="CargarAsync">
                                Reintentar
                            </MudButton>
                        </div>
                    </MudAlert>
                }

                @* TABLA *@
                <MudTable Items="Filtrados"
                          Loading="cargando"
                          LoadingProgressColor="Color.Primary"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Elevation="0"
                          RowsPerPage="10"
                          Class="exploreway-admin-tabla">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel T="GuiaSalida" SortBy="g => g.NombrePersona" InitialDirection="SortDirection.Ascending">Guía</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="GuiaSalida" SortBy="g => g.PrimerosAuxilios">Primeros auxilios</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="GuiaSalida" SortBy="g => g.EstadoDisponibilidad">Disponibilidad</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="GuiaSalida" SortBy="g => g.CalificacionPromedio">Calificación</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="GuiaSalida" SortBy="g => g.NombreEstado">Estado</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align: right;">Acciones</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Guía">
                            <div class="exploreway-admin-nombre">@NombreCompleto(context)</div>
                            @{
                                var resumen = !string.IsNullOrWhiteSpace(context.Experiencia) ? context.Experiencia : context.Biografia;
                            }
                            @if (!string.IsNullOrWhiteSpace(resumen))
                            {
                                <div class="exploreway-admin-desc" title="@resumen">@resumen</div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Primeros auxilios">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="@(context.PrimerosAuxilios ? Color.Success : Color.Default)" Class="ma-0">
                                @(context.PrimerosAuxilios ? "Sí" : "No")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Disponibilidad">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="@(context.EstadoDisponibilidad ? Color.Success : Color.Warning)" Class="ma-0">
                                @(context.EstadoDisponibilidad ? "Disponible" : "No disponible")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Calificación">
                            @if (context.CalificacionPromedio is { } nota)
                            {
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: #f59e0b;" />
                                    <span>@nota.ToString("0.0")</span>
                                </div>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="@ColorEstado(context.NombreEstado)" Class="ma-0">
                                @(string.IsNullOrWhiteSpace(context.NombreEstado) ? $"Estado {context.IdEstado}" : context.NombreEstado)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align: right; white-space: nowrap;">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary"
                                               aria-label="@($"Editar {NombreCompleto(context)}")"
                                               OnClick="@(() => EditarAsync(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Eliminar">
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                               aria-label="@($"Eliminar {NombreCompleto(context)}")"
                                               OnClick="@(() => EliminarAsync(context))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>

                    <NoRecordsContent>
                        <div class="exploreway-admin-vacio">
                            <MudIcon Icon="@Icons.Material.Outlined.Hiking" Size="Size.Large" Style="color: var(--ew-teal);" />
                            @if (_guias.Count == 0)
                            {
                                <MudText Typo="Typo.h6" Class="font-weight-bold mt-2">Todavía no hay guías</MudText>
                                <MudText Typo="Typo.body2" Style="color: #64748b;">Registrá el primero con el botón “Nuevo guía”.</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.h6" Class="font-weight-bold mt-2">Sin resultados</MudText>
                                <MudText Typo="Typo.body2" Style="color: #64748b;">Ningún guía coincide con los filtros aplicados.</MudText>
                            }
                        </div>
                    </NoRecordsContent>

                    <LoadingContent>
                        <MudText Typo="Typo.body2" Class="pa-6" Style="color: #64748b;">Cargando guías…</MudText>
                    </LoadingContent>

                    <PagerContent>
                        <MudTablePager RowsPerPageString="Filas por página:"
                                       InfoFormat="{first_item}-{last_item} de {all_items}"
                                       PageSizeOptions="new[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudTable>
            </Authorized>
        </AuthorizeView>
    </MudContainer>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> EstadoAuth { get; set; } = default!;

    private List<GuiaSalida> _guias = [];
    private List<EstadoSalida> _estados = [];
    private string _busqueda = string.Empty;
    private int? _filtroEstado;
    private bool cargando;
    private string? error;

    private IEnumerable<GuiaSalida> Filtrados => _guias.Where(g =>
        (_filtroEstado is null || g.IdEstado == _filtroEstado) &&
        (string.IsNullOrWhiteSpace(_busqueda) || Contiene(g.NombrePersona) || Contiene(g.ApellidoPersona)));

    private bool Contiene(string? texto) =>
        texto?.Contains((_busqueda ?? string.Empty).Trim(), StringComparison.OrdinalIgnoreCase) == true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await EstadoAuth;
        if (auth.User.Identity?.IsAuthenticated == true)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        try
        {
            _guias = await GuiaService.ListarAsync();
            _estados = await CargarEstadosAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }

    // Si el catálogo de estados no está disponible, se arma con los estados que traen los guías.
    private async Task<List<EstadoSalida>> CargarEstadosAsync()
    {
        try
        {
            var estados = await EstadoService.ListarPorTipoAsync("General");
            if (estados.Count > 0) return estados;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { }

        return _guias
            .GroupBy(g => g.IdEstado)
            .Select(grupo => new EstadoSalida
            {
                IdEstado = grupo.Key,
                NombreEstado = string.IsNullOrWhiteSpace(grupo.First().NombreEstado) ? $"Estado {grupo.Key}" : grupo.First().NombreEstado
            })
            .OrderBy(e => e.NombreEstado)
            .ToList();
    }

    private static string NombreCompleto(GuiaSalida g) => $"{g.NombrePersona} {g.ApellidoPersona}".Trim();

    private static Color ColorEstado(string? estado) => estado?.Trim().ToLowerInvariant() switch
    {
        "activo" or "disponible" or "habilitado" => Color.Success,
        "inactivo" or "deshabilitado" or "cerrado" => Color.Error,
        null or "" => Color.Default,
        _ => Color.Info
    };

    private Task NuevoAsync() => AbrirDialogoAsync(null);

    private Task EditarAsync(GuiaSalida guia) => AbrirDialogoAsync(guia);

    private async Task AbrirDialogoAsync(GuiaSalida? guia)
    {
        var parametros = new DialogParameters<GuiaDialogo>
        {
            { x => x.GuiaItem, guia },
            { x => x.Estados, _estados }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

        var dialogo = await Dialogos.ShowAsync<GuiaDialogo>(null, parametros, opciones);
        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled) return;

        Snackbar.Add(guia is null ? "Guía registrado." : "Guía actualizado.", Severity.Success);
        await CargarAsync();
    }

    private async Task EliminarAsync(GuiaSalida guia)
    {
        var confirmar = await Dialogos.ShowMessageBoxAsync(
            "Eliminar guía",
            $"¿Seguro que querés eliminar a “{NombreCompleto(guia)}”? Esta acción no se puede deshacer.",
            yesText: "Eliminar", cancelText: "Cancelar");
        if (confirmar != true) return;

        try
        {
            await GuiaService.EliminarAsync(guia.IdGuia);
            _guias.Remove(guia);
            Snackbar.Add("Guía eliminado.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo conectar con el servidor.", Severity.Error);
        }
    }
}
