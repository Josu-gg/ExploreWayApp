@page "/"
@using MudBlazor
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

<div id="inicio" class="exploreway-home">
    @* HERO SECTION *@
    <section class="exploreway-hero position-relative py-16 py-md-24 overflow-hidden">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 px-md-8">
            <MudGrid AlignItems="AlignItems.Center" Spacing="6">
                <MudItem xs="12" md="7">
                    <div class="d-inline-flex align-center gap-2 px-4 py-2 rounded-pill mb-4 exploreway-badge">
                        <MudIcon Icon="@Icons.Material.Filled.Hiking" Size="Size.Small" Style="color: #00A86B;" />
                        <span style="color: #00A86B; font-weight: 700; font-size: 0.875rem;">
                            Temporada de Aventuras 2026
                        </span>
                    </div>

                    <MudText Typo="Typo.h2" Class="font-weight-bold exploreway-hero-title mb-4">
                        Vive tu próxima gran aventura con 
                        <span class="exploreway-gradient-text">ExploreWay</span>
                    </MudText>

                    <MudText Typo="Typo.body1" Class="mb-8" Style="font-size: 1.15rem; color: #475569; line-height: 1.7;">
                        Descubre y gestiona expediciones de montaña, rutas de ecoturismo y buceo con guías certificados y reserva inmediata.
                    </MudText>

                    <div class="d-flex flex-wrap gap-4 align-center mb-10">
                        <MudButton Variant="Variant.Filled" 
                                   Size="Size.Large"
                                   Class="rounded-pill px-8 py-3 exploreway-btn-primary"
                                   Href="#destinos"
                                   StartIcon="@Icons.Material.Filled.Explore">
                            Ver Destinos
                        </MudButton>

                        <MudButton Variant="Variant.Outlined" 
                                   Size="Size.Large"
                                   Class="rounded-pill px-8 py-3 exploreway-btn-secondary"
                                   Href="#reserva"
                                   StartIcon="@Icons.Material.Filled.CalendarMonth">
                            Hacer Reserva
                        </MudButton>
                    </div>
                </MudItem>

                <MudItem xs="12" md="5" Class="d-flex justify-center">
                    <div class="exploreway-hero-card shadow-xl rounded-2xl overflow-hidden position-relative">
                        <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1000&q=80" 
                             alt="ExploreWay Aventura" 
                             class="exploreway-hero-img" />
                        <div class="exploreway-hero-card-overlay pa-6">
                            <MudChip T="string" Size="Size.Small" Class="mb-2" Style="background: #00A86B; color: white;">
                                Destino Destacado
                            </MudChip>
                            <MudText Typo="Typo.h6" Class="text-white font-weight-bold">
                                Parque Nacional Torres del Paine
                            </MudText>
                            <MudText Typo="Typo.body2" Style="color: #e2e8f0;">
                                5 días · Trekking Guiado · Todo Incluido
                            </MudText>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </section>

    @* SECCIÓN DE RESERVA RÁPIDA *@
    <section id="reserva" class="py-8">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 px-md-8">
            <MudPaper Elevation="4" Class="pa-6 pa-md-8 rounded-2xl exploreway-booking-bar">
                <MudText Typo="Typo.h5" Class="font-weight-bold mb-1" Style="color: #00A86B;">
                    Reserva Rápida de Aventura
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-6" Style="color: #64748b;">
                    Configura los detalles de tu viaje para verificar disponibilidad.
                </MudText>

                <MudGrid Spacing="3" AlignItems="AlignItems.Center">
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string" Label="Destino" @bind-Value="_selectedDestination" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Patagonia Chilena")">Patagonia Chilena</MudSelectItem>
                            <MudSelectItem Value="@("Selva Costa Rica")">Selva Costa Rica</MudSelectItem>
                            <MudSelectItem Value="@("Alpes Suizos")">Alpes Suizos</MudSelectItem>
                            <MudSelectItem Value="@("Arrecife Caribeño")">Arrecife Caribeño</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="string" Label="Actividad" @bind-Value="_selectedType" Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Trekking & Montaña")">Trekking & Montaña</MudSelectItem>
                            <MudSelectItem Value="@("Buceo & Snorkel")">Buceo & Snorkel</MudSelectItem>
                            <MudSelectItem Value="@("Kayak & Ríos")">Kayak & Ríos</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker Label="Fecha de Salida" @bind-Date="_selectedDate" Variant="Variant.Outlined" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudButton Variant="Variant.Filled" 
                                   FullWidth="true" 
                                   Size="Size.Large"
                                   Class="rounded-lg py-3 exploreway-btn-primary"
                                   OnClick="ConsultarDisponibilidad"
                                   StartIcon="@Icons.Material.Filled.Search">
                            Ver Cupos
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudContainer>
    </section>

    @* SECCIÓN DESTINOS *@
    <section id="destinos" class="py-16">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 px-md-8">
            <div class="text-center mb-12">
                <MudText Typo="Typo.h3" Class="font-weight-bold mb-3">
                    Nuestros Destinos Populares
                </MudText>
                <MudText Typo="Typo.body1" Style="color: #64748b;">
                    Experiencias diseñadas con los más altos estándares de seguridad y sostenibilidad.
                </MudText>
            </div>

            <MudGrid Spacing="4">
                @foreach (var tour in _toursDestacados)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="2" Class="exploreway-card h-100 rounded-2xl overflow-hidden">
                            <MudCardMedia Image="@tour.Imagen" Height="220" />
                            <MudCardContent Class="pa-5">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudChip T="string" Size="Size.Small" Style="background: rgba(0,168,107,0.12); color: #00A86B; font-weight: 600;">
                                        @tour.Categoria
                                    </MudChip>
                                    <span style="color: #00A86B; font-weight: 700;">@tour.Precio</span>
                                </div>
                                <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">@tour.Titulo</MudText>
                                <MudText Typo="Typo.body2" Style="color: #64748b;">@tour.Descripcion</MudText>
                            </MudCardContent>
                            <MudCardActions Class="px-5 pb-5">
                                <MudButton Variant="Variant.Outlined" 
                                           FullWidth="true" 
                                           Style="border-color: #00A86B; color: #00A86B;"
                                           OnClick="@(() => ConsultarDisponibilidad())">
                                    Reservar Ahora
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    </section>

    @* SECCIÓN SOBRE NOSOTROS *@
    <section id="nosotros" class="py-16 bg-white">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 px-md-8">
            <MudGrid Spacing="6" AlignItems="AlignItems.Center">
                <MudItem xs="12" md="6">
                    <img src="https://images.unsplash.com/photo-1526772662000-3f88f10405ff?auto=format&fit=crop&w=1000&q=80" 
                         alt="Equipo ExploreWay" 
                         class="rounded-2xl shadow-lg w-100" 
                         style="max-height: 400px; object-fit: cover;" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.overline" Style="color: #5BBAE3; font-weight: 700;">
                        SOBRE NOSOTROS
                    </MudText>
                    <MudText Typo="Typo.h3" Class="font-weight-bold mb-4">
                        Tu compañero de confianza en cada ruta
                    </MudText>
                    <MudText Typo="Typo.body1" Class="mb-4" Style="color: #475569; line-height: 1.7;">
                        En <strong>ExploreWay</strong> facilitamos la organización de tus viajes de aventura combinando tecnología intuitiva, guías locales expertos y respeto por la biodiversidad.
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </section>
</div>

@code {
    private string _selectedDestination = "Patagonia Chilena";
    private string _selectedType = "Trekking & Montaña";
    private DateTime? _selectedDate = DateTime.Today.AddDays(10);

    public class TourItem
    {
        public string Titulo { get; set; } = "";
        public string Categoria { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public string Imagen { get; set; } = "";
        public string Precio { get; set; } = "";
    }

    private List<TourItem> _toursDestacados = new()
    {
        new TourItem
        {
            Titulo = "Glaciar Perito Moreno",
            Categoria = "Montaña",
            Descripcion = "Expedición sobre hielo con equipamiento técnico y guía especializado.",
            Imagen = "https://images.unsplash.com/photo-1517411032315-54ef2cb783bb?auto=format&fit=crop&w=800&q=80",
            Precio = "$380 USD"
        },
        new TourItem
        {
            Titulo = "Arrecife Mesoamericano",
            Categoria = "Buceo",
            Descripcion = "Inmersión guiada en aguas cristalinas de alta biodiversidad marina.",
            Imagen = "https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=800&q=80",
            Precio = "$290 USD"
        },
        new TourItem
        {
            Titulo = "Ruta Volcánica & Termas",
            Categoria = "Ecoturismo",
            Descripcion = "Senderismo entre bosques nubosos y aguas termales naturales.",
            Imagen = "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80",
            Precio = "$220 USD"
        }
    };

    private void ConsultarDisponibilidad()
    {
        Snackbar.Add($"Buscando cupos para {_selectedDestination}...", Severity.Success);
    }
}