@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable

@inject IJSRuntime JS

<PageTitle>ExploreWay | Expediciones del volcán al arrecife</PageTitle>

@*
    EL DESCENSO
    El inicio es un solo viaje vertical: de la cumbre (2 600 m) al arrecife (-18 m).
    Las alturas de cada parada son las reales de cada lugar de El Salvador y alimentan el altímetro fijo.
    El comportamiento (parallax, altímetro, revelados) vive en wwwroot/js/inicio.js.
*@

<div class="ew-inicio ew-pre" id="ew-inicio">

    @* ALTÍMETRO — lectura viva de la altitud mientras se baja *@
    <aside class="ew-alt" aria-hidden="true">
        <div class="ew-alt-lectura">
            <span class="ew-alt-num">2 600</span><span class="ew-alt-unidad">m</span>
        </div>
        <span class="ew-alt-ref">sobre el nivel del mar</span>
        <div class="ew-alt-regla"><i class="ew-alt-marca"></i></div>
    </aside>

    @* ============ HERO ============ *@
    <section id="inicio" class="ew-hero" data-alt="2600">

        <div class="ew-escena ew-escena--fondo" aria-hidden="true">
            <div class="ew-cielo"></div>
            <div class="ew-estrellas"></div>
            <div class="ew-luna" data-prof="0.04"></div>

            <svg class="ew-capa" data-prof="0.12" data-cresta="alpina" data-base="560" data-amp="400" style="--n:0" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
                <defs>
                    <linearGradient id="ew-g0" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#4a86ad" /><stop offset="0.4" stop-color="#25527a" /><stop offset="1" stop-color="#17365c" />
                    </linearGradient>
                </defs>
                <path fill="url(#ew-g0)" d="M-50 900 L-50 560 L400 470 L800 560 L1200 450 L1650 560 L1650 900Z" />
            </svg>
            <svg class="ew-capa" data-prof="0.28" data-cresta="alpina" data-base="640" data-amp="260" style="--n:1" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
                <defs>
                    <linearGradient id="ew-g1" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#2f7390" /><stop offset="0.5" stop-color="#17475f" /><stop offset="1" stop-color="#0f3345" />
                    </linearGradient>
                </defs>
                <path fill="url(#ew-g1)" d="M-50 900 L-50 650 L500 600 L900 660 L1300 590 L1650 650 L1650 900Z" />
            </svg>
            <svg class="ew-capa" data-prof="0.46" data-cresta="suave" data-base="680" data-amp="140" style="--n:2" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
                <defs>
                    <linearGradient id="ew-g2" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#14705a" /><stop offset="0.5" stop-color="#0c4a47" /><stop offset="1" stop-color="#082b33" />
                    </linearGradient>
                </defs>
                <path fill="url(#ew-g2)" d="M-50 900 L-50 720 L500 700 L1000 740 L1650 700 L1650 900Z" />
            </svg>
        </div>

        <div class="ew-hero-cuerpo">
            <h1 class="ew-titular">
                <span class="ew-linea"><span style="--d:420">Del volcán</span></span>
                <span class="ew-linea"><span style="--d:540">al arrecife.</span></span>
            </h1>
            <p class="ew-sub ew-entra" style="--d:900">
                Expediciones por volcanes, lagos y arrecifes de El Salvador con guías certificados.
                Elegí tu destino, reservá tu cupo y salí a explorar.
            </p>
            <div class="ew-acciones ew-entra" style="--d:1050">
                <a class="ew-btn" href="/cliente/destinos">Ver destinos</a>
                <a class="ew-enlace" href="#pasos" @onclick="@(() => IrASeccionAsync("#pasos"))" @onclick:preventDefault>Cómo funciona</a>
            </div>
        </div>

        <div class="ew-escena ew-escena--frente" aria-hidden="true">
            <svg class="ew-capa" data-prof="0.7" data-cresta="suave" data-base="780" data-amp="70" style="--n:3" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
                <defs>
                    <linearGradient id="ew-g3" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#0a3b2e" /><stop offset="1" stop-color="#052019" />
                    </linearGradient>
                </defs>
                <path fill="url(#ew-g3)" d="M-50 900 L-50 790 L600 770 L1100 800 L1650 770 L1650 900Z" />
            </svg>
            <svg class="ew-capa" data-prof="1" data-cresta="bosque" data-base="850" data-amp="90" style="--n:4" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
                <path fill="#041517" d="M-50 900 L-50 840 L1650 840 L1650 900Z" />
            </svg>
        </div>

        <nav class="ew-ruta ew-entra" style="--d:1250" aria-label="Destinos del viaje">
            <a href="#parada-santaana" @onclick="@(() => IrASeccionAsync("#parada-santaana"))" @onclick:preventDefault>
                <span class="ew-ruta-nombre">Volcán de Santa Ana</span>
                <span class="ew-ruta-alt">2 381 m</span>
            </a>
            <a href="#parada-coatepeque" @onclick="@(() => IrASeccionAsync("#parada-coatepeque"))" @onclick:preventDefault>
                <span class="ew-ruta-nombre">Lago de Coatepeque</span>
                <span class="ew-ruta-alt">745 m</span>
            </a>
            <a href="#parada-cobanos" @onclick="@(() => IrASeccionAsync("#parada-cobanos"))" @onclick:preventDefault>
                <span class="ew-ruta-nombre">Arrecife de Los Cóbanos</span>
                <span class="ew-ruta-alt">−18 m</span>
            </a>
        </nav>
    </section>

    @* ============ TRAMO DE TIERRA: GLACIAR Y VOLCÁN ============ *@
    <div id="destinos" class="ew-tramo ew-tramo--tierra">

        <article id="parada-santaana" class="ew-parada" data-alt="2381" data-ew-in>
            <figure class="ew-foto">
                <img src="/img/santa-ana.jpg"
                     width="1920" height="1440" alt="Laguna de color verde esmeralda dentro del cráter del volcán de Santa Ana" loading="lazy" />
            </figure>
            <div class="ew-parada-texto">
                <h2 class="ew-nombre">
                    <span class="ew-linea"><span style="--d:150">Volcán</span></span>
                    <span class="ew-linea"><span style="--d:260">de Santa Ana</span></span>
                </h2>
                <p class="ew-tipo">Trekking de volcán</p>
                <p class="ew-desc">Ascenso guiado hasta el cráter, a 2 381 m, donde espera una laguna de color esmeralda.</p>
                <p class="ew-precio">Desde <strong>$380 USD</strong> por persona</p>
                <a class="ew-btn" href="/cliente/destinos">Reservar cupo</a>
            </div>
        </article>

        <article id="parada-coatepeque" class="ew-parada ew-parada--inv" data-alt="745" data-ew-in>
            <figure class="ew-foto">
                <img src="/img/coatepeque.jpg"
                     width="1500" height="1125" alt="Lago de Coatepeque, de agua turquesa, rodeado de bosque" loading="lazy" />
            </figure>
            <div class="ew-parada-texto">
                <h2 class="ew-nombre">
                    <span class="ew-linea"><span style="--d:150">Lago de</span></span>
                    <span class="ew-linea"><span style="--d:260">Coatepeque</span></span>
                </h2>
                <p class="ew-tipo">Kayak y senderismo</p>
                <p class="ew-desc">Remá sobre un lago de cráter a 745 m y recorré sus miradores entre bosques.</p>
                <p class="ew-precio">Desde <strong>$220 USD</strong> por persona</p>
                <a class="ew-btn" href="/cliente/destinos">Reservar cupo</a>
            </div>
        </article>
    </div>

    @* ============ LA ORILLA: NIVEL DEL MAR ============ *@
    <section id="pasos" class="ew-tramo ew-tramo--costa" data-alt="0">
        <div class="ew-ola" aria-hidden="true">
            <svg viewBox="0 0 1600 90" preserveAspectRatio="none" class="ew-ola-a">
                <path d="M0 0H1600V46 q-50 -34 -100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0Z" />
            </svg>
            <svg viewBox="0 0 1600 90" preserveAspectRatio="none" class="ew-ola-b">
                <path d="M0 0H1600V30 q-50 -26 -100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0 t-100 0Z" />
            </svg>
        </div>

        <div class="ew-pasos-cab" data-ew-in>
            <h2 class="ew-titulo-sec">Reservar lleva tres pasos</h2>
        </div>

        <ol class="ew-pasos-lista" data-ew-in>
            <li>
                <span class="ew-paso-n">1</span>
                <h3>Elegí tu aventura</h3>
                <p>Destinos y actividades verificadas, con cupos reales.</p>
            </li>
            <li>
                <span class="ew-paso-n">2</span>
                <h3>Reservá tu cupo</h3>
                <p>Confirmá al instante y recibí tu itinerario completo.</p>
            </li>
            <li>
                <span class="ew-paso-n">3</span>
                <h3>Viví la experiencia</h3>
                <p>Salí con guías certificados y contanos cómo te fue.</p>
            </li>
        </ol>
    </section>

    @* ============ TRAMO DE MAR: ARRECIFE, NOSOTROS Y CIERRE ============ *@
    <div class="ew-tramo ew-tramo--mar">
        <div class="ew-luz-agua" aria-hidden="true"></div>

        <article id="parada-cobanos" class="ew-parada" data-alt="-18" data-ew-in>
            <figure class="ew-foto">
                <img src="/img/cobanos.jpg"
                     width="1920" height="1536" alt="Coral negro bajo el agua en el arrecife de Los Cóbanos" loading="lazy" />
            </figure>
            <div class="ew-parada-texto">
                <h2 class="ew-nombre">
                    <span class="ew-linea"><span style="--d:150">Arrecife de</span></span>
                    <span class="ew-linea"><span style="--d:260">Los Cóbanos</span></span>
                </h2>
                <p class="ew-tipo">Buceo guiado</p>
                <p class="ew-desc">Inmersión guiada hasta 18 m en el área marina protegida, entre coral negro y peces de arrecife.</p>
                <p class="ew-precio">Desde <strong>$290 USD</strong> por persona</p>
                <a class="ew-btn" href="/cliente/destinos">Reservar cupo</a>
            </div>
        </article>

        <section id="nosotros" class="ew-nosotros" data-alt="-30">
            <div class="ew-nosotros-texto" data-ew-in>
                <h2 class="ew-titulo-sec">Tu compañero de confianza en cada ruta</h2>
                <p>
                    En <strong>ExploreWay</strong> organizamos tus viajes de aventura con tecnología simple,
                    guías locales expertos y respeto por la biodiversidad.
                </p>
                <p>
                    Llevamos nueve años operando y trabajamos con más de 65 guías certificados.
                </p>
            </div>
            <figure class="ew-ojo" data-ew-in>
                <img src="/img/cerro-verde.jpg"
                     width="1280" height="960" alt="Cerros del Parque Nacional Cerro Verde bajo un cielo con nubes" loading="lazy" />
            </figure>
        </section>

        <section class="ew-cierre" data-alt="-30">
            <div class="ew-burbujas" aria-hidden="true">
                @for (var i = 0; i < _burbujas.Length; i++)
                {
                    var b = _burbujas[i];
                    <i style="--x:@(b.X)%;--s:@(b.S)px;--t:@(b.T)s;--d:@(b.D)s"></i>
                }
            </div>
            <div class="ew-cierre-cuerpo" data-ew-in>
                <h2 class="ew-cierre-titulo">Elegí por dónde empezar</h2>
                <p>Reservá tu cupo al instante y dejá el resto en manos de tu guía.</p>
                <div class="ew-acciones">
                    <a class="ew-btn" href="/cliente/destinos">Explorar destinos</a>
                    <AuthorizeView>
                        <NotAuthorized>
                            <a class="ew-enlace" href="/registro">Crear cuenta</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
            <p class="ew-creditos">
                Fotos de Erneestoo y JMRAFFi (CC BY-SA 4.0 y CC BY 4.0) y de ChikaReef (CC BY-SA 4.0),
                vía Wikimedia Commons.
            </p>
        </section>
    </div>
</div>

@code {
    // Burbujas del cierre: posición (%), tamaño (px), duración y retraso (s). Fijas para que el render sea estable.
    private static readonly (int X, int S, int T, int D)[] _burbujas =
    [
        (6, 8, 11, 0), (14, 14, 14, 3), (23, 6, 9, 6), (31, 10, 13, 1), (42, 18, 16, 5),
        (51, 7, 10, 8), (60, 12, 14, 2), (69, 9, 12, 7), (78, 16, 17, 4), (86, 7, 10, 9), (93, 11, 13, 6)
    ];

    private bool _iniciado;

    private async Task IrASeccionAsync(string idSeccion)
        => await JS.InvokeVoidAsync("exploreWayJs.scrollToSection", idSeccion);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Con prerender, el DOM se reemplaza al activar el circuito interactivo: el comportamiento
        // (crestas, parallax, altímetro, revelados) se enciende solo cuando el contenido ya es el definitivo.
        if (firstRender)
        {
            await JS.InvokeVoidAsync("ewInicio.init");
            _iniciado = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_iniciado) return;
        try
        {
            await JS.InvokeVoidAsync("ewInicio.dispose");
        }
        catch (JSDisconnectedException)
        {
            // El circuito ya se cerró: no hay nada que limpiar.
        }
        catch (InvalidOperationException)
        {
            // Navegación durante el prerender o cierre del circuito.
        }
    }
}
