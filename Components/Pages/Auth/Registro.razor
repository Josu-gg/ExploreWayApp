@page "/registro"
@layout ExploreWayApp.Components.Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using ExploreWayApp.DTOs.Auth
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Servicios

@inject IAuthService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager Navegacion

<PageTitle>Crear cuenta — ExploreWay</PageTitle>

<div class="ea-pagina">

    <aside class="ea-foto">
        <img class="ea-foto-img" src="/img/coatepeque.jpg" alt="" />
        <a href="/" class="ea-marca" aria-label="ExploreWay, ir al inicio">
            <svg viewBox="0 0 40 40" aria-hidden="true">
                <rect x="1" y="1" width="38" height="38" rx="11" fill="#0b1329" stroke="#5BE3C2" stroke-opacity=".45" />
                <path d="M6 27 L16 11 L21 19 L25 14 L34 27 Z" fill="#5BE3C2" />
                <path d="M6 31 q3.5 -3 7 0 t7 0 t7 0 t7 0" fill="none" stroke="#5BBAE3" stroke-width="2.2" stroke-linecap="round" />
            </svg>
            <span class="ea-marca-nombre">Explore<b>Way</b></span>
        </a>
        <div class="ea-foto-texto">
            <h2 class="ea-foto-titulo">Reservá con un guía que conoce el lugar.</h2>
            <p class="ea-foto-bajada">Creá tu cuenta gratis. Ver destinos y precios no la necesita; reservar una salida sí.</p>
        </div>
        <p class="ea-pie"><b>745 m</b> Lago de Coatepeque</p>
    </aside>

    <main class="ea-panel">
        <a href="/" class="ea-volver">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Volver al inicio
        </a>

        <div class="ea-tarjeta ea-tarjeta--ancha">
            <h1 class="ea-titulo">Crear cuenta</h1>
            <p class="ea-sub">Completá tus datos para empezar a reservar.</p>

            @if (error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="ea-aviso">@error</MudAlert>
            }

            <MudForm @ref="_formulario">
                <fieldset class="ea-grupo">
                    <legend class="ea-grupo-titulo">Tus datos</legend>
                    <div class="ea-campos">
                        <MudTextField T="string" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.None"
                                      autocomplete="given-name" @bind-Value="datos.Nombre" Validation="ValidarNombre" />
                        <MudTextField T="string" Label="Apellido" Variant="Variant.Outlined" Margin="Margin.None"
                                      autocomplete="family-name" @bind-Value="datos.Apellido" Validation="ValidarApellido" />
                        <MudTextField T="string" Label="Teléfono" Placeholder="+503 7000-0000"
                                      Variant="Variant.Outlined" Margin="Margin.None"
                                      InputType="InputType.Telephone" autocomplete="tel"
                                      @bind-Value="datos.Telefono" Validation="ValidarTelefono" />
                        <MudDatePicker Label="Nacimiento (opcional)"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.None"
                                       Editable="true"
                                       MaxDate="DateTime.Today"
                                       DateFormat="dd/MM/yyyy"
                                       @bind-Date="_fechaNacimiento" />
                        <div class="ea-ancho">
                            <MudTextField T="string" Label="Dirección (opcional)" Variant="Variant.Outlined" Margin="Margin.None"
                                          autocomplete="street-address" @bind-Value="datos.Direccion" Validation="ValidarDireccion" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="ea-grupo">
                    <legend class="ea-grupo-titulo">Tu cuenta</legend>
                    <div class="ea-campos">
                        <div class="ea-ancho">
                            <MudTextField T="string" Label="Correo electrónico" Placeholder="tu@correo.com"
                                          Variant="Variant.Outlined" Margin="Margin.None"
                                          InputType="InputType.Email" autocomplete="username"
                                          @bind-Value="datos.Correo" Validation="ValidarCorreo" />
                        </div>
                        <div class="ea-ancho">
                            <MudTextField T="string"
                                          Label="Contraseña"
                                          HelperText="Mínimo 8 caracteres, con al menos una letra y un número."
                                          Variant="Variant.Outlined"
                                          Margin="Margin.None"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_verContra ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                          AdornmentAriaLabel="@(_verContra ? "Ocultar contraseña" : "Mostrar contraseña")"
                                          OnAdornmentClick="AlternarContra"
                                          InputType="@(_verContra ? InputType.Text : InputType.Password)"
                                          autocomplete="new-password"
                                          @bind-Value="datos.Contra"
                                          Validation="ValidarContra" />
                        </div>
                        <div class="ea-ancho">
                            <MudTextField T="string" Label="Confirmar contraseña" Variant="Variant.Outlined" Margin="Margin.None"
                                          InputType="@(_verContra ? InputType.Text : InputType.Password)"
                                          autocomplete="new-password"
                                          @bind-Value="_confirmacion" Validation="ValidarConfirmacion" />
                        </div>
                    </div>
                </fieldset>

                <MudButton Variant="Variant.Filled"
                           FullWidth="true"
                           Class="ea-boton"
                           Disabled="enviando"
                           OnClick="EnviarAsync">
                    @if (enviando)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="color: #ffffff;" />
                    }
                    @(enviando ? "Creando cuenta…" : "Crear cuenta")
                </MudButton>
            </MudForm>

            <p class="ea-cambio">
                ¿Ya tenés cuenta?
                <MudLink Href="@RutaLogin" Class="ea-enlace">Iniciar sesión</MudLink>
            </p>
        </div>
    </main>
</div>

@code {
    // Si llegó desde una reserva, el inicio de sesión lo devuelve a ella. Solo rutas internas.
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string RutaLogin =>
        !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.Contains('\\')
            ? $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}"
            : "/login";

    private readonly RegistroClienteGuardar datos = new();
    private MudForm _formulario = default!;
    private DateTime? _fechaNacimiento;
    private string _confirmacion = string.Empty;
    private string? error;
    private bool enviando;
    private bool _verContra;

    private static string? Requerido(string? valor, string mensaje, int max)
    {
        if (string.IsNullOrWhiteSpace(valor)) return mensaje;
        if (valor.Trim().Length > max) return $"No puede superar {max} caracteres.";
        return null;
    }

    private Func<string, string?> ValidarNombre => v => Requerido(v, "El nombre es obligatorio.", 100);
    private Func<string, string?> ValidarApellido => v => Requerido(v, "El apellido es obligatorio.", 100);

    private Func<string, string?> ValidarTelefono => v =>
    {
        if (string.IsNullOrWhiteSpace(v)) return "El teléfono es obligatorio.";
        if (!Regex.IsMatch(v.Trim(), @"^[0-9+\-\s]{8,20}$"))
            return "Solo números, +, - y espacios (8 a 20 caracteres).";
        return null;
    };

    private Func<string?, string?> ValidarDireccion => v =>
        v is { Length: > 250 } ? "La dirección no puede superar 250 caracteres." : null;

    private Func<string, string?> ValidarCorreo => v =>
    {
        if (string.IsNullOrWhiteSpace(v)) return "El correo es obligatorio.";
        if (!new EmailAddressAttribute().IsValid(v.Trim())) return "El formato del correo no es válido.";
        return null;
    };

    private Func<string, string?> ValidarContra => v =>
    {
        if (string.IsNullOrWhiteSpace(v)) return "La contraseña es obligatoria.";
        if (v.Length < 8 || v.Length > 72) return "Debe tener entre 8 y 72 caracteres.";
        if (!Regex.IsMatch(v, @"^(?=.*[A-Za-z])(?=.*\d).+$")) return "Debe incluir al menos una letra y un número.";
        return null;
    };

    private Func<string, string?> ValidarConfirmacion => v =>
        v != datos.Contra ? "Las contraseñas no coinciden." : null;

    private void AlternarContra() => _verContra = !_verContra;

    private async Task EnviarAsync()
    {
        if (enviando) return;

        await _formulario.ValidateAsync();
        if (!_formulario.IsValid) return;

        enviando = true;
        error = null;

        try
        {
            datos.Nombre = datos.Nombre.Trim();
            datos.Apellido = datos.Apellido.Trim();
            datos.Telefono = datos.Telefono.Trim();
            datos.Correo = datos.Correo.Trim();
            datos.Direccion = string.IsNullOrWhiteSpace(datos.Direccion) ? null : datos.Direccion.Trim();
            datos.FechaNacimiento = _fechaNacimiento is { } f ? DateOnly.FromDateTime(f) : null;

            await AuthService.RegistrarClienteAsync(datos);
            Snackbar.Add("¡Cuenta creada! Ya podés iniciar sesión.", Severity.Success);
            Navegacion.NavigateTo(RutaLogin);
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            enviando = false;
        }
    }
}
