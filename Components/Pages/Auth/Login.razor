@page "/login"
@layout ExploreWayApp.Components.Layout.AuthLayout

@using System.ComponentModel.DataAnnotations
@using ExploreWayApp.DTOs.Auth
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Auth
@using ExploreWayApp.Servicios

@inject IAuthService AuthService
@inject SesionUsuario Sesion
@inject ISnackbar Snackbar
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesión — ExploreWay</PageTitle>

<div class="ea-pagina">

    <aside class="ea-foto">
        <img class="ea-foto-img" src="/img/santa-ana.jpg" alt="" />
        <a href="/" class="ea-marca" aria-label="ExploreWay, ir al inicio">
            <svg viewBox="0 0 40 40" aria-hidden="true">
                <rect x="1" y="1" width="38" height="38" rx="11" fill="#0b1329" stroke="#5BE3C2" stroke-opacity=".45" />
                <path d="M6 27 L16 11 L21 19 L25 14 L34 27 Z" fill="#5BE3C2" />
                <path d="M6 31 q3.5 -3 7 0 t7 0 t7 0 t7 0" fill="none" stroke="#5BBAE3" stroke-width="2.2" stroke-linecap="round" />
            </svg>
            <span class="ea-marca-nombre">Explore<b>Way</b></span>
        </a>
        <div class="ea-foto-texto">
            <h2 class="ea-foto-titulo">Tu próxima salida te espera.</h2>
            <p class="ea-foto-bajada">Entrá para ver tus reservas y elegir con quién explorar el próximo volcán, lago o arrecife.</p>
        </div>
        <p class="ea-pie"><b>2 381 m</b> Volcán de Santa Ana</p>
    </aside>

    <main class="ea-panel">
        <a href="/" class="ea-volver">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            Volver al inicio
        </a>

        <div class="ea-tarjeta">
            <h1 class="ea-titulo">Iniciar sesión</h1>
            <p class="ea-sub">Ingresá con tu correo y contraseña para continuar.</p>

            @if (error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="ea-aviso">@error</MudAlert>
            }

            <MudForm @ref="_formulario">
                <MudTextField T="string"
                              Label="Correo electrónico"
                              Placeholder="tu@correo.com"
                              Variant="Variant.Outlined"
                              Margin="Margin.None"
                              Class="mb-4"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              InputType="InputType.Email"
                              autocomplete="username"
                              @bind-Value="credenciales.Correo"
                              Validation="ValidarCorreo" />

                <MudTextField T="string"
                              Label="Contraseña"
                              Variant="Variant.Outlined"
                              Margin="Margin.None"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_verContra ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              AdornmentAriaLabel="@(_verContra ? "Ocultar contraseña" : "Mostrar contraseña")"
                              OnAdornmentClick="AlternarContra"
                              InputType="@(_verContra ? InputType.Text : InputType.Password)"
                              autocomplete="current-password"
                              @bind-Value="credenciales.Contra"
                              Validation="ValidarContra"
                              OnKeyDown="AlPulsarTecla" />

                <div class="ea-olvido">
                    <MudLink Href="#" Typo="Typo.body2" Class="ea-enlace">¿Olvidaste tu contraseña?</MudLink>
                </div>

                <MudButton Variant="Variant.Filled"
                           FullWidth="true"
                           Class="ea-boton"
                           Disabled="enviando"
                           OnClick="EnviarAsync">
                    @if (enviando)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="color: #ffffff;" />
                    }
                    @(enviando ? "Ingresando…" : "Iniciar sesión")
                </MudButton>
            </MudForm>

            <p class="ea-cambio">
                ¿Todavía no tenés cuenta?
                <MudLink Href="@RutaRegistro" Class="ea-enlace">Crear cuenta</MudLink>
            </p>
        </div>
    </main>
</div>

@code {
    private readonly LoginGuardar credenciales = new();
    private MudForm _formulario = default!;
    private string? error;
    private bool enviando;
    private bool _verContra;

    // Si el cliente llegó desde "Reservar", vuelve a esa reserva. Solo se aceptan rutas internas.
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string RutaRegistro =>
        string.IsNullOrWhiteSpace(ReturnUrl) ? "/registro" : $"/registro?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    private string DestinoCliente() =>
        Sesion.EsCliente && !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.Contains('\\')
            ? ReturnUrl
            : "/";

    private Func<string, string?> ValidarCorreo => valor =>
    {
        if (string.IsNullOrWhiteSpace(valor)) return "El correo es obligatorio.";
        if (!new EmailAddressAttribute().IsValid(valor.Trim())) return "El formato del correo no es válido.";
        return null;
    };

    private Func<string, string?> ValidarContra => valor =>
        string.IsNullOrWhiteSpace(valor) ? "La contraseña es obligatoria." : null;

    private void AlternarContra() => _verContra = !_verContra;

    private async Task AlPulsarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await EnviarAsync();
    }

    private async Task EnviarAsync()
    {
        if (enviando) return;

        await _formulario.ValidateAsync();
        if (!_formulario.IsValid) return;

        enviando = true;
        error = null;

        try
        {
            await AuthService.IniciarSesionAsync(credenciales);
            Snackbar.Add($"¡Bienvenido/a de nuevo, {Sesion.NombreCompleto}!", Severity.Success);
            Navegacion.NavigateTo(Sesion.EsAdmin ? "/admin" : Sesion.EsGuia ? "/guia" : DestinoCliente());
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            enviando = false;
        }
    }
}
