@using ExploreWayApp.Auth
@using ExploreWayApp.Components.Compartidos
@using ExploreWayApp.Config
@using ExploreWayApp.DTOs.guia
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Servicios.Guia
@using ExploreWayApp.Servicios.Imagenes

@inject IGuiaService GuiaService
@inject ICloudinaryService CloudinaryService
@inject SesionUsuario Sesion

<MudDialog Class="exploreway-destino-dialogo">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Badge" Style="color: var(--ew-primary);" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">Editar mi perfil</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" Style="border-radius: 12px;">
                @error
            </MudAlert>
        }

        <MudForm @ref="_formulario" Model="modelo">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mb-2" Style="color: #64748b;">Foto de perfil</MudText>
                    <SelectorFoto UrlActual="@Guia.Foto" PermitirQuitar="true"
                                  @bind-Archivo="_foto" @bind-Quitar="_quitarFoto" Deshabilitado="guardando" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Biografía"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="4"
                                  Counter="500"
                                  MaxLength="500"
                                  @bind-Value="modelo.Biografia"
                                  For="@(() => modelo.Biografia)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Experiencia"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  Counter="500"
                                  MaxLength="500"
                                  @bind-Value="modelo.Experiencia"
                                  For="@(() => modelo.Experiencia)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Estudios"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Counter="200"
                                  MaxLength="200"
                                  @bind-Value="modelo.Estudios"
                                  For="@(() => modelo.Estudios)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool?" Color="Color.Primary" Label="Tengo primeros auxilios"
                               @bind-Value="modelo.PrimerosAuxilios" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool?" Color="Color.Primary" Label="Estoy disponible"
                               @bind-Value="modelo.EstadoDisponibilidad" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Class="text-none" Disabled="guardando" OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled"
                   Class="rounded-pill px-6 text-none exploreway-btn-auth"
                   Disabled="guardando"
                   OnClick="GuardarAsync">
            @if (guardando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="color: #ffffff;" />
            }
            @(guardando ? "Guardando…" : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public GuiaSalida Guia { get; set; } = default!;

    private readonly GuiaPerfilModificar modelo = new();
    private MudForm _formulario = default!;
    private IBrowserFile? _foto;
    private bool _quitarFoto;
    private string? error;
    private bool guardando;

    protected override void OnInitialized()
    {
        modelo.Biografia = Guia.Biografia;
        modelo.Experiencia = Guia.Experiencia;
        modelo.Estudios = Guia.Estudios;
        modelo.PrimerosAuxilios = Guia.PrimerosAuxilios;
        modelo.EstadoDisponibilidad = Guia.EstadoDisponibilidad;
    }

    private void Cancelar() => MudDialog.Cancel();

    private async Task GuardarAsync()
    {
        if (guardando) return;

        await _formulario.ValidateAsync();
        if (!_formulario.IsValid) return;

        guardando = true;
        error = null;

        try
        {
            modelo.Biografia = string.IsNullOrWhiteSpace(modelo.Biografia) ? null : modelo.Biografia.Trim();
            modelo.Experiencia = string.IsNullOrWhiteSpace(modelo.Experiencia) ? null : modelo.Experiencia.Trim();
            modelo.Estudios = string.IsNullOrWhiteSpace(modelo.Estudios) ? null : modelo.Estudios.Trim();

            // null = sin cambios, vacío = quitar la foto, URL = foto nueva.
            modelo.Foto = null;
            if (_foto is not null)
            {
                await using var flujo = _foto.OpenReadStream(LimitesImagen.TamanoMaximoBytes);
                modelo.Foto = await CloudinaryService.SubirFotoGuiaAsync(flujo, _foto.Name);
            }
            else if (_quitarFoto)
            {
                modelo.Foto = string.Empty;
            }

            var actualizado = await GuiaService.ModificarMiPerfilAsync(modelo);
            if (modelo.Foto is not null) Sesion.ActualizarFoto(actualizado?.Foto);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException)
        {
            error = "No se pudo conectar con el servidor. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }
}
