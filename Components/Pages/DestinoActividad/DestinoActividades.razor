@page "/admin/destino-actividades"
@layout AdminLayout

@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using ExploreWayApp.DTOs.actividad
@using ExploreWayApp.DTOs.Destino
@using ExploreWayApp.DTOs.DestinoActividad
@using ExploreWayApp.DTOs.Estado
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Servicios.actividad
@using ExploreWayApp.Servicios.Destino
@using ExploreWayApp.Servicios.DestinoActividad
@using ExploreWayApp.Servicios.Estado

@inject IDestinoActividadService AsignacionService
@inject IDestinoService DestinoService
@inject IActividadService ActividadService
@inject IEstadoService EstadoService
@inject IDialogService Dialogos
@inject ISnackbar Snackbar

<PageTitle>Actividades por destino — ExploreWay</PageTitle>

<div class="exploreway-admin">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 px-md-8">

        <AuthorizeView>
            <NotAuthorized>
                <div class="exploreway-admin-vacio">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Style="color: var(--ew-primary);" />
                    <MudText Typo="Typo.h5" Class="font-weight-bold mt-3">Iniciá sesión para gestionar asignaciones</MudText>
                    <MudText Typo="Typo.body2" Class="mb-5" Style="color: #64748b;">
                        Esta sección es solo para usuarios autenticados.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Href="/login" Class="rounded-pill px-6 text-none exploreway-btn-auth">
                        Iniciar sesión
                    </MudButton>
                </div>
            </NotAuthorized>

            <Authorized Context="_auth">
                @* ENCABEZADO *@
                <header class="exploreway-admin-head">
                    <div>
                        <span class="exploreway-admin-kicker">Ofertas · @_asignaciones.Count registradas</span>
                        <MudText Typo="Typo.h3" Class="font-weight-bold exploreway-section-title">Asignar actividad a destino</MudText>
                        <MudText Typo="Typo.body1" Class="exploreway-section-lead">
                            Definí qué actividades se ofrecen en cada destino, con su duración y precio base.
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Add"
                               Class="rounded-pill px-6 py-2 text-none exploreway-btn-auth"
                               Disabled="cargando"
                               OnClick="NuevoAsync">
                        Nueva asignación
                    </MudButton>
                </header>

                @* BARRA DE FILTROS *@
                <div class="exploreway-admin-filtros">
                    <MudTextField @bind-Value="_busqueda"
                                  Placeholder="Buscar por destino o actividad"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  AdornmentColor="Color.Primary"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="exploreway-admin-buscar" />

                    <MudChipSet T="int?" @bind-SelectedValue="_filtroEstado" SelectionMode="SelectionMode.SingleSelection"
                                CheckMark="false">
                        <MudChip T="int?" Value="@((int?)null)" Default="true" Variant="Variant.Outlined" Color="Color.Primary">
                            Todos
                        </MudChip>
                        @foreach (var estado in _estados)
                        {
                            <MudChip T="int?" Value="@estado.IdEstado" Variant="Variant.Outlined" Color="Color.Primary">
                                @estado.NombreEstado
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                @if (error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Style="border-radius: 12px;"
                              ContentAlignment="HorizontalAlignment.Start">
                        <div class="d-flex align-center justify-space-between flex-wrap gap-3">
                            <span>@error</span>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                       Class="text-none" OnClick="CargarAsync">
                                Reintentar
                            </MudButton>
                        </div>
                    </MudAlert>
                }

                @* TABLA *@
                <MudTable Items="Filtradas"
                          Loading="cargando"
                          LoadingProgressColor="Color.Primary"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Elevation="0"
                          RowsPerPage="10"
                          Class="exploreway-admin-tabla">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel T="DestinoActividadSalida" SortBy="a => a.NombreDestino" InitialDirection="SortDirection.Ascending">Destino</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="DestinoActividadSalida" SortBy="a => a.NombreActividad">Actividad</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="DestinoActividadSalida" SortBy="a => a.DuracionMinutos">Duración</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="DestinoActividadSalida" SortBy="a => a.PrecioBase">Precio base</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel T="DestinoActividadSalida" SortBy="a => a.NombreEstado">Estado</MudTableSortLabel></MudTh>
                        <MudTh Style="text-align: right;">Acciones</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Destino">
                            <div class="exploreway-admin-nombre">@context.NombreDestino</div>
                        </MudTd>
                        <MudTd DataLabel="Actividad">
                            <div class="exploreway-admin-nombre">@context.NombreActividad</div>
                            @if (!string.IsNullOrWhiteSpace(context.Dificultad))
                            {
                                <div class="exploreway-admin-desc">Dificultad: @context.Dificultad</div>
                            }
                        </MudTd>
                        <MudTd DataLabel="Duración">@FormatoDuracion(context.DuracionMinutos)</MudTd>
                        <MudTd DataLabel="Precio base">@FormatoPrecio(context.PrecioBase)</MudTd>
                        <MudTd DataLabel="Estado">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                     Color="@ColorEstado(context.NombreEstado)" Class="ma-0">
                                @(string.IsNullOrWhiteSpace(context.NombreEstado) ? $"Estado {context.IdEstado}" : context.NombreEstado)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align: right; white-space: nowrap;">
                            <MudTooltip Text="Editar">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary"
                                               aria-label="@($"Editar {context.NombreActividad} en {context.NombreDestino}")"
                                               OnClick="@(() => EditarAsync(context))" />
                            </MudTooltip>
                            @if (PuedeAlternar)
                            {
                                var activa = context.IdEstado == _idActivo;
                                <MudTooltip Text="@(activa ? "Dar de baja" : "Reactivar")">
                                    <MudIconButton Icon="@(activa ? Icons.Material.Outlined.PauseCircle : Icons.Material.Outlined.PlayCircle)"
                                                   Size="Size.Small"
                                                   Color="@(activa ? Color.Error : Color.Success)"
                                                   aria-label="@((activa ? "Dar de baja " : "Reactivar ") + context.NombreActividad)"
                                                   OnClick="@(() => AlternarEstadoAsync(context))" />
                                </MudTooltip>
                            }
                        </MudTd>
                    </RowTemplate>

                    <NoRecordsContent>
                        <div class="exploreway-admin-vacio">
                            <MudIcon Icon="@Icons.Material.Outlined.Hiking" Size="Size.Large" Style="color: var(--ew-teal);" />
                            @if (_asignaciones.Count == 0)
                            {
                                <MudText Typo="Typo.h6" Class="font-weight-bold mt-2">Todavía no hay asignaciones</MudText>
                                <MudText Typo="Typo.body2" Style="color: #64748b;">Creá la primera con el botón “Nueva asignación”.</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.h6" Class="font-weight-bold mt-2">Sin resultados</MudText>
                                <MudText Typo="Typo.body2" Style="color: #64748b;">Ninguna asignación coincide con los filtros aplicados.</MudText>
                            }
                        </div>
                    </NoRecordsContent>

                    <LoadingContent>
                        <MudText Typo="Typo.body2" Class="pa-6" Style="color: #64748b;">Cargando asignaciones…</MudText>
                    </LoadingContent>

                    <PagerContent>
                        <MudTablePager RowsPerPageString="Filas por página:"
                                       InfoFormat="{first_item}-{last_item} de {all_items}"
                                       PageSizeOptions="new[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudTable>
            </Authorized>
        </AuthorizeView>
    </MudContainer>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> EstadoAuth { get; set; } = default!;

    private List<DestinoActividadSalida> _asignaciones = [];
    private List<DestinoSalidaDto> _destinos = [];
    private List<ActividadSalida> _actividades = [];
    private List<EstadoSalida> _estados = [];
    private string _busqueda = string.Empty;
    private int? _filtroEstado;
    private bool cargando;
    private string? error;

    private int? _idActivo => _estados.FirstOrDefault(e => Normalizar(e.NombreEstado) == "activo")?.IdEstado;
    private int? _idInactivo => _estados.FirstOrDefault(e => Normalizar(e.NombreEstado) == "inactivo")?.IdEstado;
    private bool PuedeAlternar => _idActivo is not null && _idInactivo is not null;

    private IEnumerable<DestinoActividadSalida> Filtradas => _asignaciones.Where(a =>
        (_filtroEstado is null || a.IdEstado == _filtroEstado) &&
        (string.IsNullOrWhiteSpace(_busqueda) || Contiene(a.NombreDestino) || Contiene(a.NombreActividad)));

    private bool Contiene(string? texto) =>
        texto?.Contains(_busqueda.Trim(), StringComparison.OrdinalIgnoreCase) == true;

    private static string Normalizar(string? texto) => texto?.Trim().ToLowerInvariant() ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await EstadoAuth;
        if (auth.User.Identity?.IsAuthenticated == true)
            await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        try
        {
            _asignaciones = await AsignacionService.ListarAsync();
            _estados = await EstadoService.ListarPorTipoAsync("General");
            _destinos = (await DestinoService.ListarAsync()).OrderBy(d => d.Nombre).ToList();
            var pagina = await ActividadService.ListarAsync(1, 200);
            _actividades = pagina.Contenido.OrderBy(a => a.Nombre).ToList();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        catch (HttpRequestException)
        {
            error = "No se pudo conectar con el servidor. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }

    private static string FormatoDuracion(int minutos)
    {
        var horas = minutos / 60;
        var resto = minutos % 60;
        if (horas == 0) return $"{resto} min";
        return resto == 0 ? $"{horas} h" : $"{horas} h {resto} min";
    }

    private static string FormatoPrecio(decimal precio) =>
        "$ " + precio.ToString("N2", CultureInfo.InvariantCulture);

    private static Color ColorEstado(string? estado) => estado?.Trim().ToLowerInvariant() switch
    {
        "activo" or "disponible" or "habilitado" => Color.Success,
        "inactivo" or "deshabilitado" or "cerrado" => Color.Error,
        null or "" => Color.Default,
        _ => Color.Info
    };

    private Task NuevoAsync() => AbrirDialogoAsync(null);

    private Task EditarAsync(DestinoActividadSalida item) => AbrirDialogoAsync(item);

    private async Task AbrirDialogoAsync(DestinoActividadSalida? item)
    {
        var parametros = new DialogParameters<DestinoActividadDialogo>
        {
            { x => x.Item, item },
            { x => x.Estados, _estados },
            { x => x.Destinos, _destinos },
            { x => x.Actividades, _actividades }
        };
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

        var dialogo = await Dialogos.ShowAsync<DestinoActividadDialogo>(null, parametros, opciones);
        var resultado = await dialogo.Result;
        if (resultado is null || resultado.Canceled) return;

        Snackbar.Add(item is null ? "Asignación creada." : "Asignación actualizada.", Severity.Success);
        await CargarAsync();
    }

    private async Task AlternarEstadoAsync(DestinoActividadSalida item)
    {
        if (_idActivo is not int idActivo || _idInactivo is not int idInactivo) return;

        var darDeBaja = item.IdEstado == idActivo;
        var confirmar = await Dialogos.ShowMessageBoxAsync(
            darDeBaja ? "Dar de baja asignación" : "Reactivar asignación",
            darDeBaja
                ? $"¿Seguro que querés dar de baja “{item.NombreActividad}” en {item.NombreDestino}?"
                : $"¿Querés reactivar “{item.NombreActividad}” en {item.NombreDestino}?",
            yesText: darDeBaja ? "Dar de baja" : "Reactivar", cancelText: "Cancelar");
        if (confirmar != true) return;

        try
        {
            await AsignacionService.ModificarAsync(item.IdDestinoActividad, new DestinoActividadModificar
            {
                DuracionMinutos = item.DuracionMinutos,
                PrecioBase = item.PrecioBase,
                IdEstado = darDeBaja ? idInactivo : idActivo
            });
            Snackbar.Add(darDeBaja ? "Asignación dada de baja." : "Asignación reactivada.", Severity.Success);
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo conectar con el servidor.", Severity.Error);
        }
    }
}
