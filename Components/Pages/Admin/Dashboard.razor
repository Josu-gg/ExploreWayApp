@page "/admin"
@layout AdminLayout

@using ExploreWayApp.Auth
@using ExploreWayApp.DTOs.Destino
@using ExploreWayApp.Excepciones
@using ExploreWayApp.Servicios.Destino

@inject IDestinoService DestinoService
@inject SesionUsuario Sesion

<PageTitle>Panel general — ExploreWay</PageTitle>

<div class="ew-admin-page">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="px-4 px-md-8">

        <header class="ew-admin-head">
            <div>
                <span class="ew-admin-kicker">Resumen</span>
                <MudText Typo="Typo.h3" Class="font-weight-bold exploreway-section-title">
                    Hola, @PrimerNombre
                </MudText>
                <MudText Typo="Typo.body1" Class="exploreway-section-lead">
                    Este es el estado actual de ExploreWay.
                </MudText>
            </div>
        </header>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4" Style="border-radius: 12px;">@_error</MudAlert>
        }

        @* INDICADORES *@
        <MudGrid Spacing="3" Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <div class="ew-stat">
                    <span class="ew-stat-icon" style="background: rgba(0,168,107,.12); color: var(--ew-primary);">
                        <MudIcon Icon="@Icons.Material.Filled.Landscape" />
                    </span>
                    <span class="ew-stat-label">Destinos</span>
                    <span class="ew-stat-value">@(_cargando ? "…" : _destinos.Count.ToString())</span>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ew-stat">
                    <span class="ew-stat-icon" style="background: rgba(91,186,227,.16); color: #2b8db8;">
                        <MudIcon Icon="@Icons.Material.Filled.Map" />
                    </span>
                    <span class="ew-stat-label">Departamentos</span>
                    <span class="ew-stat-value">@(_cargando ? "…" : _destinos.Select(d => d.Departamento).Distinct().Count().ToString())</span>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ew-stat">
                    <span class="ew-stat-icon" style="background: rgba(91,227,194,.2); color: var(--ew-green-ink);">
                        <MudIcon Icon="@Icons.Material.Filled.Flag" />
                    </span>
                    <span class="ew-stat-label">Estados en uso</span>
                    <span class="ew-stat-value">@(_cargando ? "…" : _destinos.Select(d => d.IdEstado).Distinct().Count().ToString())</span>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="ew-stat">
                    <span class="ew-stat-icon" style="background: rgba(103,190,203,.2); color: #3a8f9c;">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" />
                    </span>
                    <span class="ew-stat-label">Tu rol</span>
                    <span class="ew-stat-value ew-stat-value--text">@Sesion.NombreRol</span>
                </div>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3">
            @* ÚLTIMOS DESTINOS *@
            <MudItem xs="12" md="8">
                <div class="ew-panel">
                    <div class="ew-panel-head">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Destinos recientes</MudText>
                        <MudButton Href="/admin/destinos" Size="Size.Small" Color="Color.Primary" Class="text-none"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Ver todos
                        </MudButton>
                    </div>

                    @if (_cargando)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_destinos.Count == 0)
                    {
                        <div class="ew-panel-vacio">
                            <MudIcon Icon="@Icons.Material.Outlined.TravelExplore" Size="Size.Large" Style="color: var(--ew-teal);" />
                            <MudText Typo="Typo.body2" Style="color: #64748b;">Todavía no hay destinos registrados.</MudText>
                        </div>
                    }
                    else
                    {
                        <ul class="ew-lista">
                            @foreach (var d in Recientes)
                            {
                                <li>
                                    <MudIcon Icon="@Icons.Material.Outlined.Place" Size="Size.Small" Style="color: var(--ew-primary);" />
                                    <div class="ew-lista-texto">
                                        <strong>@d.Nombre</strong>
                                        <span>@(string.IsNullOrWhiteSpace(d.Municipio) ? d.Departamento : $"{d.Municipio}, {d.Departamento}")</span>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ma-0">
                                        @(d.NombreEstado ?? $"Estado {d.IdEstado}")
                                    </MudChip>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </MudItem>

            @* ACCESOS RÁPIDOS *@
            <MudItem xs="12" md="4">
                <div class="ew-panel">
                    <div class="ew-panel-head">
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Accesos rápidos</MudText>
                    </div>
                    <div class="ew-accesos">
                        <a href="/admin/destinos" class="ew-acceso">
                            <MudIcon Icon="@Icons.Material.Filled.Landscape" />
                            <span>Gestionar destinos</span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                        </a>
                        <a href="/admin/perfil" class="ew-acceso">
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                            <span>Mi perfil</span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                        </a>
                        <a href="/" class="ew-acceso">
                            <MudIcon Icon="@Icons.Material.Filled.Public" />
                            <span>Ver sitio público</span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                        </a>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>
</div>

@code {
    private List<DestinoSalidaDto> _destinos = [];
    private bool _cargando = true;
    private string? _error;

    private string PrimerNombre =>
        Sesion.NombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "administrador";

    private IEnumerable<DestinoSalidaDto> Recientes => _destinos.OrderByDescending(d => d.IdDestino).Take(6);

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.Autenticado)
        {
            _cargando = false;
            return;
        }

        try
        {
            _destinos = await DestinoService.ListarAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con el servidor. Verificá tu conexión e intentá de nuevo.";
        }
        finally
        {
            _cargando = false;
        }
    }
}
