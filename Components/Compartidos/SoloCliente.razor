@using Microsoft.AspNetCore.Components.Authorization
@using ExploreWayApp.Auth

@inject SesionUsuario Sesion
@inject NavigationManager Navegacion

@* Restringe una vista al rol Cliente. Se muestra dentro del MainLayout.
   Los invitados ven una invitación a crear cuenta o iniciar sesión y vuelven a esta misma página después. *@
<AuthorizeView Roles="Cliente">
    <Authorized>
        @ChildContent
    </Authorized>
    <NotAuthorized>
        <div class="ex-pagina">
            <div class="ex-contenedor" style="padding-top: 9rem; padding-bottom: 5rem;">
                <div class="ex-puerta">
                    @if (Sesion.Autenticado)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Style="color: var(--ew-green-ink);" />
                        <h1>Esta sección es para clientes</h1>
                        <p>Tu cuenta no tiene acceso a las reservas. Podés seguir explorando los destinos.</p>
                        <div class="ex-puerta-acciones">
                            <a class="ex-btn ex-btn--primario" href="/explorar">Ver destinos</a>
                        </div>
                    }
                    else
                    {
                        var retorno = Uri.EscapeDataString("/" + Navegacion.ToBaseRelativePath(Navegacion.Uri));
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Large" Style="color: var(--ew-green-ink);" />
                        <h1>Creá tu cuenta para reservar</h1>
                        <p>Es gratis y tarda un minuto. Después volvés justo acá para seguir con tu reserva.</p>
                        <div class="ex-puerta-acciones">
                            <a class="ex-btn ex-btn--verde" href="/registro?returnUrl=@retorno">Crear cuenta</a>
                            <a class="ex-btn ex-btn--linea" href="/login?returnUrl=@retorno">Ya tengo cuenta</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
