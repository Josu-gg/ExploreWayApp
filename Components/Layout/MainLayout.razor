@inherits LayoutComponentBase
@using MudBlazor

@* Proveedores globales de MudBlazor con la paleta ExploreWay *@
<MudThemeProvider Theme="_exploreWayTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Class="exploreway-layout">
    @* HEADER / APPBAR RESPONSIVO *@
    <MudAppBar Elevation="1" Dense="false" Class="exploreway-appbar px-4 px-md-8">
        @* Logotipo e Identidad *@
        <div class="d-flex align-center cursor-pointer" @onclick="@(() => NavigateTo("#inicio"))">
            <div class="exploreway-logo-badge mr-3">
                <MudIcon Icon="@Icons.Material.Filled.Explore" Size="Size.Medium" Style="color: #00A86B;" />
            </div>
            <div>
                <MudText Typo="Typo.h5" Class="exploreway-brand-title font-weight-bold">
                    Explore<span style="color: #00A86B;">Way</span>
                </MudText>
            </div>
        </div>

        <MudSpacer />

        @* Menú Principal en Header (Sin buscador) *@
        <div class="d-none d-md-flex align-center gap-6">
            <MudLink Href="#inicio" Underline="Underline.None" Class="exploreway-navlink active">Inicio</MudLink>
            <MudLink Href="#destinos" Underline="Underline.None" Class="exploreway-navlink">Destinos</MudLink>
            <MudLink Href="#reserva" Underline="Underline.None" Class="exploreway-navlink">Reserva</MudLink>
            <MudLink Href="#nosotros" Underline="Underline.None" Class="exploreway-navlink">Sobre Nosotros</MudLink>
        </div>

        <MudSpacer />

        @* Botones de Inicio de Sesión y Registro *@
        <div class="d-none d-sm-flex align-center gap-3">
            <MudButton Variant="Variant.Outlined" 
                       Class="rounded-pill px-5 py-2 text-capitalize"
                       OnClick="AbrirModalLogin"
                       Style="border-color: #00A86B; color: #00A86B; font-weight: 600;">
                Iniciar Sesión
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Class="rounded-pill px-5 py-2 text-capitalize exploreway-btn-cta"
                       OnClick="AbrirModalRegistro"
                       Style="background: linear-gradient(135deg, #00A86B, #5BBAE3); font-weight: 600; color: #ffffff;">
                Registrarse
            </MudButton>
        </div>

        @* Botón Hamburguesa para Móviles *@
        <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                       Color="Color.Default" 
                       Edge="Edge.End" 
                       Class="d-flex d-md-none ml-2" 
                       OnClick="@ToggleDrawer" />
    </MudAppBar>

    @* DRAWER MÓVIL *@
    <MudDrawer @bind-Open="_drawerOpen" 
               ClipMode="DrawerClipMode.Never" 
               Elevation="3" 
               Anchor="Anchor.Right" 
               Variant="DrawerVariant.Temporary"
               Class="exploreway-drawer pa-4">
        <MudDrawerHeader Class="d-flex justify-space-between align-center px-2 py-4">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Explore" Style="color: #00A86B;" Class="mr-2" />
                <MudText Typo="Typo.h6" Style="font-weight: 700;">Explore<span style="color: #00A86B;">Way</span></MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@ToggleDrawer" />
        </MudDrawerHeader>

        <MudDivider Class="my-2" />

        <MudNavMenu Class="exploreway-mobile-nav py-3">
            <MudNavLink Href="#inicio" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" OnClick="@CloseDrawer">Inicio</MudNavLink>
            <MudNavLink Href="#destinos" Icon="@Icons.Material.Filled.Landscape" OnClick="@CloseDrawer">Destinos</MudNavLink>
            <MudNavLink Href="#reserva" Icon="@Icons.Material.Filled.EventAvailable" OnClick="@CloseDrawer">Reserva</MudNavLink>
            <MudNavLink Href="#nosotros" Icon="@Icons.Material.Filled.Groups" OnClick="@CloseDrawer">Sobre Nosotros</MudNavLink>
        </MudNavMenu>

        <MudDivider Class="my-4" />

        <div class="d-flex flex-column gap-3 mt-auto pb-4">
            <MudButton Variant="Variant.Outlined" 
                       FullWidth="true" 
                       Class="rounded-pill py-2 text-capitalize"
                       Style="border-color: #00A86B; color: #00A86B;"
                       OnClick="@(() => { CloseDrawer(); AbrirModalLogin(); })">
                Iniciar Sesión
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       FullWidth="true" 
                       Class="rounded-pill py-2 text-capitalize"
                       Style="background: linear-gradient(135deg, #00A86B, #5BBAE3); color: white;"
                       OnClick="@(() => { CloseDrawer(); AbrirModalRegistro(); })">
                Registrarse
            </MudButton>
        </div>
    </MudDrawer>

    @* VISTA PRINCIPAL (HOME) *@
    <MudMainContent Class="exploreway-main-content">
        @Body
    </MudMainContent>

    @* FOOTER INSTITUCIONAL *@
    <footer class="exploreway-footer">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-12 px-4 px-md-8">
            <MudGrid Spacing="4">
                <MudItem xs="12" sm="6" md="4">
                    <div class="d-flex align-center mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Explore" Size="Size.Large" Style="color: #5BE3C2;" Class="mr-2" />
                        <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                            Explore<span style="color: #5BE3C2;">Way</span>
                        </MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="line-height: 1.7; color: #cbd5e1;">
                        Conectando a exploradores intrépidos con las maravillas naturales más asombrosas del planeta. Expediciones seguras y sostenibles.
                    </MudText>
                    <div class="d-flex gap-2">
                        <MudIconButton Icon="@Icons.Custom.Brands.Instagram" Style="color: #5BE3C2;" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Style="color: #5BE3C2;" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Custom.Brands.YouTube" Style="color: #5BE3C2;" Size="Size.Small" />
                    </div>
                </MudItem>

                <MudItem xs="6" sm="3" md="2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3" Style="color: #5BE3C2;">Navegación</MudText>
                    <ul class="exploreway-footer-links">
                        <li><a href="#inicio">Inicio</a></li>
                        <li><a href="#destinos">Destinos</a></li>
                        <li><a href="#reserva">Reserva</a></li>
                        <li><a href="#nosotros">Sobre Nosotros</a></li>
                    </ul>
                </MudItem>

                <MudItem xs="6" sm="3" md="2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3" Style="color: #5BBAE3;">Aventuras</MudText>
                    <ul class="exploreway-footer-links">
                        <li><a href="#destinos">Trekking & Montaña</a></li>
                        <li><a href="#destinos">Buceo & Océanos</a></li>
                        <li><a href="#destinos">Ecoturismo Selva</a></li>
                        <li><a href="#destinos">Glamping Exclusivo</a></li>
                    </ul>
                </MudItem>

                <MudItem xs="12" sm="12" md="4">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="color: #67BECB;">Boletín de Aventuras</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3" Style="color: #94a3b8;">
                        Recibe guías de rutas y promociones para tu próximo viaje.
                    </MudText>
                    <div class="d-flex gap-2">
                        <MudTextField @bind-Value="_newsletterEmail" Placeholder="tucorreo@ejemplo.com" Variant="Variant.Outlined" Margin="Margin.Dense" Class="exploreway-footer-input" />
                        <MudButton Variant="Variant.Filled" Style="background: #00A86B; color: white;" OnClick="SuscribirNewsletter">
                            Unirme
                        </MudButton>
                    </div>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-8" Style="background-color: rgba(255,255,255,0.12);" />

            <div class="d-flex flex-column flex-sm-row justify-space-between align-center gap-3">
                <MudText Typo="Typo.caption" Style="color: #94a3b8;">
                    © @DateTime.Now.Year ExploreWay. Todos los derechos reservados.
                </MudText>
                <div class="d-flex gap-4">
                    <a href="#terminos" class="exploreway-sublink">Términos y Condiciones</a>
                    <a href="#privacidad" class="exploreway-sublink">Privacidad</a>
                </div>
            </div>
        </MudContainer>
    </footer>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private string _newsletterEmail = "";

    @inject ISnackbar Snackbar
    @inject NavigationManager NavManager

    // Paleta oficial ExploreWay
    private MudTheme _exploreWayTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#00A86B",
            Secondary = "#5BE3C2",
            Info = "#5BBAE3",
            Success = "#67BECB",
            AppbarBackground = "rgba(255, 255, 255, 0.95)",
            AppbarText = "#1e293b",
            Background = "#f8fafc",
            Surface = "#ffffff",
            TextPrimary = "#0f172a",
            TextSecondary = "#475569"
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer() => _drawerOpen = false;
    private void NavigateTo(string target) => NavManager.NavigateTo(target);

    private void AbrirModalLogin() => Snackbar.Add("Iniciando acceso seguro...", Severity.Info);
    private void AbrirModalRegistro() => Snackbar.Add("Bienvenido a ExploreWay. Completa tu perfil.", Severity.Success);
    private void SuscribirNewsletter()
    {
        if (!string.IsNullOrWhiteSpace(_newsletterEmail))
        {
            Snackbar.Add("¡Suscrito al boletín de ExploreWay!", Severity.Success);
            _newsletterEmail = "";
        }
    }
}