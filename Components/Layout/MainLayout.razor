@inherits LayoutComponentBase
@implements IDisposable
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using ExploreWayApp.Auth
@using ExploreWayApp.Servicios
@inject ISnackbar Snackbar
@inject NavigationManager NavManager
@inject SesionUsuario Sesion
@inject IAuthService AuthService
@inject IDialogService Dialogos
@inject ExploreWayApp.Servicios.Cliente.IClienteService ClienteService
@inject ExploreWayApp.Servicios.Imagenes.FotoPerfilLocal FotosLocal

@* Proveedores globales de MudBlazor con la paleta ExploreWay *@
<MudThemeProvider Theme="TemaExploreWay.Instancia" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Class="exploreway-layout">

    @* Cierra el menú de usuario al hacer clic fuera. Va fuera del AppBar: su transform atraparía el overlay fijo. *@
    <MudOverlay @bind-Visible="_menuAbierto" AutoClose="true" ZIndex="1150" />

    @* APPBAR ADAPTATIVA — TRANSPARENTE SOBRE EL HERO, SÓLIDA AL BAJAR *@
    <MudAppBar Elevation="0" Dense="false" Class="exploreway-appbar px-4 px-md-8">
        <a href="#inicio" class="exploreway-brand d-flex align-center text-decoration-none">
            <div class="exploreway-logo-badge mr-3">
                <MudIcon Icon="@Icons.Material.Filled.Explore" Size="Size.Medium" />
            </div>
            <MudText Typo="Typo.h5" Class="font-weight-bold exploreway-brand-title">
                Explore<span class="exploreway-brand-way">Way</span>
            </MudText>
            <span class="exploreway-brand-coords d-none d-lg-inline">S 50.9° W 73.0°</span>
        </a>

        <MudSpacer />

        <nav class="exploreway-nav d-none d-md-flex align-center" aria-label="Secciones de la página">
            <a href="/#inicio" class="exploreway-navlink active" data-section-link="inicio">Inicio</a>
            <AuthorizeView Roles="Cliente">
                <Authorized Context="_cli">
                    <a href="/cliente/destinos" class="exploreway-navlink">Destinos</a>
                    <a href="/cliente/reservas" class="exploreway-navlink">Mis reservas</a>
                </Authorized>
                <NotAuthorized Context="_nocli">
                    <a href="/cliente/destinos" class="exploreway-navlink">Destinos</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="/#nosotros" class="exploreway-navlink" data-section-link="nosotros">Nosotros</a>
            <span class="exploreway-nav-pill" aria-hidden="true"></span>
        </nav>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <div class="d-none d-sm-flex align-center gap-3">
                    <div class="ew-usermenu">
                        <div class="ew-usermenu-activador" role="button" tabindex="0" aria-haspopup="menu" aria-expanded="@_menuAbierto.ToString().ToLowerInvariant()"
                             @onclick="AlternarMenu" @onkeydown="AlPulsarTecla">
                            <MudAvatar Color="Color.Primary" Size="Size.Medium">@if (!string.IsNullOrWhiteSpace(Sesion.Foto)){<img src="@Sesion.Foto" alt="@Sesion.NombreCompleto" style="width:100%;height:100%;object-fit:cover;" />}else{@Iniciales}</MudAvatar>
                            <div class="d-flex flex-column" style="line-height: 1.2;">
                                <MudText Typo="Typo.body2" Class="font-weight-bold">@Sesion.NombreCompleto</MudText>
                                <MudText Typo="Typo.caption">@Sesion.NombreRol</MudText>
                            </div>
                            <MudIcon Icon="@(_menuAbierto ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                        </div>

                        <MudPopover Open="_menuAbierto" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                    Style="z-index: 1300;" Class="ew-usermenu-panel">
                            <div class="ew-menu-cabecera">
                                <MudAvatar Color="Color.Primary" Style="width: 56px; height: 56px; font-size: 1.2rem;">@if (!string.IsNullOrWhiteSpace(Sesion.Foto)){<img src="@Sesion.Foto" alt="@Sesion.NombreCompleto" style="width:100%;height:100%;object-fit:cover;" />}else{@Iniciales}</MudAvatar>
                                <div class="ew-menu-cabecera-datos">
                                    <strong>@Sesion.NombreCompleto</strong>
                                    <span>@Sesion.Correo</span>
                                    <span class="ew-menu-rol">@Sesion.NombreRol</span>
                                </div>
                            </div>
                            <MudDivider />
                            @if (Sesion.EsCliente)
                            {
                                <a class="ew-usermenu-item" href="/cliente/perfil" @onclick="CerrarMenu">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" /> Ver mi perfil
                                </a>
                                <button type="button" class="ew-usermenu-item" @onclick="EditarPerfilAsync">
                                    <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" /> Editar perfil y foto
                                </button>
                                <a class="ew-usermenu-item" href="/cliente/reservas" @onclick="CerrarMenu">
                                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /> Mis reservas
                                </a>
                            }
                            @if (Sesion.EsAdmin)
                            {
                                <a class="ew-usermenu-item" href="/admin" @onclick="CerrarMenu">
                                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /> Panel de administración
                                </a>
                            }
                            @if (Sesion.EsGuia)
                            {
                                <a class="ew-usermenu-item" href="/guia" @onclick="CerrarMenu">
                                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" /> Panel de guía
                                </a>
                            }
                            <MudDivider />
                            <button type="button" class="ew-usermenu-item ew-usermenu-item--salir" @onclick="CerrarSesion">
                                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" /> Cerrar sesión
                            </button>
                        </MudPopover>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="d-none d-sm-flex align-center gap-3">
                    <MudButton Variant="Variant.Outlined"
                               Href="/login"
                               Class="rounded-pill px-5 py-2 text-none exploreway-btn-session">
                        Iniciar Sesión
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Href="/registro"
                               Class="rounded-pill px-5 py-2 text-none exploreway-btn-cta">
                        Registrarse
                    </MudButton>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Default"
                       Edge="Edge.End"
                       Class="d-flex d-md-none ml-2 exploreway-hamburger"
                       OnClick="@ToggleDrawer" />
    </MudAppBar>

    @* DRAWER MÓVIL *@
    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Never"
               Elevation="3"
               Anchor="Anchor.Right"
               Variant="DrawerVariant.Temporary"
               Class="exploreway-drawer pa-4">

        <MudDrawerHeader Class="d-flex justify-space-between align-center px-2 py-4">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Explore" Style="color: #00A86B;" Class="mr-2" />
                <MudText Typo="Typo.h6" Style="font-weight: 700;">
                    Explore<span style="color: #00A86B;">Way</span>
                </MudText>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           OnClick="@ToggleDrawer" />
        </MudDrawerHeader>

        <MudDivider Class="my-2" />

        <MudNavMenu Class="exploreway-mobile-nav py-3">
            <MudNavLink Href="#inicio" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home" OnClick="@CloseDrawer">
                Inicio
            </MudNavLink>

            <AuthorizeView Roles="Cliente">
                <Authorized Context="_cli">
                    <MudNavLink Href="/cliente/destinos" Icon="@Icons.Material.Filled.Landscape" OnClick="@CloseDrawer">
                        Destinos
                    </MudNavLink>
                    <MudNavLink Href="/cliente/reservas" Icon="@Icons.Material.Filled.History" OnClick="@CloseDrawer">
                        Mis reservas
                    </MudNavLink>
                    <MudNavLink Href="/cliente/perfil" Icon="@Icons.Material.Filled.Person" OnClick="@CloseDrawer">
                        Ver mi perfil
                    </MudNavLink>
                    <MudNavLink Icon="@Icons.Material.Filled.PhotoCamera" OnClick="EditarPerfilAsync">
                        Editar perfil y foto
                    </MudNavLink>
                </Authorized>
                <NotAuthorized Context="_nocli">
                    <MudNavLink Href="/cliente/destinos" Icon="@Icons.Material.Filled.Landscape" OnClick="@CloseDrawer">
                        Destinos
                    </MudNavLink>
                </NotAuthorized>
            </AuthorizeView>

            <MudNavLink Href="#nosotros" Icon="@Icons.Material.Filled.Groups" OnClick="@CloseDrawer">
                Sobre Nosotros
            </MudNavLink>
        </MudNavMenu>

        <MudDivider Class="my-4" />

        <AuthorizeView>
            <Authorized>
                <div class="d-flex flex-column gap-3 mt-auto pb-4">
                    <div class="d-flex align-center gap-3 px-2">
                        <MudAvatar Color="Color.Primary">@if (!string.IsNullOrWhiteSpace(Sesion.Foto)){<img src="@Sesion.Foto" alt="@Sesion.NombreCompleto" style="width:100%;height:100%;object-fit:cover;" />}else{@Iniciales}</MudAvatar>
                        <div class="d-flex flex-column" style="line-height: 1.2;">
                            <MudText Typo="Typo.body2" Class="font-weight-bold">@Sesion.NombreCompleto</MudText>
                            <MudText Typo="Typo.caption">@Sesion.Correo</MudText>
                        </div>
                    </div>
                    @if (Sesion.EsAdmin)
                    {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Dashboard"
                               Href="/admin"
                               Class="rounded-pill py-2 text-none"
                               OnClick="@CloseDrawer">
                        Panel de administración
                    </MudButton>
                    }
                    @if (Sesion.EsGuia)
                    {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Badge"
                               Href="/guia"
                               Class="rounded-pill py-2 text-none"
                               OnClick="@CloseDrawer">
                        Panel de guía
                    </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               Class="rounded-pill py-2 text-none"
                               OnClick="@CerrarSesion">
                        Cerrar sesión
                    </MudButton>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="d-flex flex-column gap-3 mt-auto pb-4">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               Href="/login"
                               Class="rounded-pill py-2 text-none"
                               OnClick="@IrALogin">
                        Iniciar Sesión
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Href="/registro"
                               Class="rounded-pill py-2 text-none exploreway-btn-cta"
                               OnClick="@AbrirModalRegistro">
                        Registrarse
                    </MudButton>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </MudDrawer>

    @* CONTENIDO PRINCIPAL DE LAS VISTAS *@
    <MudMainContent Class="exploreway-main-content">
        @Body
    </MudMainContent>

    @* FOOTER TEMÁTICO EXPLOREWAY *@
    <footer class="exploreway-footer">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-12 px-4 px-md-8">
            <MudGrid Spacing="4">
                <MudItem xs="12" sm="6" md="4">
                    <div class="d-flex align-center mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Explore" Size="Size.Large" Style="color: #5BE3C2;" Class="mr-2" />
                        <MudText Typo="Typo.h5" Class="font-weight-bold text-white">
                            Explore<span style="color: #5BE3C2;">Way</span>
                        </MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mb-4" Style="line-height: 1.7; color: #cbd5e1;">
                        Plataforma integral para la gestión de aventuras y viajes turísticos. Conectamos exploradores con experiencias únicas y seguras alrededor del mundo.
                    </MudText>
                    <div class="d-flex gap-2">
                        <MudIconButton Icon="@Icons.Custom.Brands.Instagram" Style="color: #5BE3C2;" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Style="color: #5BE3C2;" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Custom.Brands.YouTube" Style="color: #5BE3C2;" Size="Size.Small" />
                        <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Style="color: #5BE3C2;" Size="Size.Small" />
                    </div>
                </MudItem>

                <MudItem xs="6" sm="3" md="2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3" Style="color: #5BE3C2;">
                        Menú
                    </MudText>
                    <ul class="exploreway-footer-links">
                        <li><a href="#inicio">Inicio</a></li>
                        <li><a href="/cliente/destinos">Destinos</a></li>
                        <li><a href="#nosotros">Sobre Nosotros</a></li>
                    </ul>
                </MudItem>

                <MudItem xs="6" sm="3" md="2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3" Style="color: #5BBAE3;">
                        Experiencias
                    </MudText>
                    <ul class="exploreway-footer-links">
                        <li><a href="#destinos">Senderismo & Montaña</a></li>
                        <li><a href="#destinos">Buceo & Arrecifes</a></li>
                        <li><a href="#destinos">Rutas Ecoturísticas</a></li>
                        <li><a href="#destinos">Campamentos Guiados</a></li>
                    </ul>
                </MudItem>

                <MudItem xs="12" sm="12" md="4">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2" Style="color: #67BECB;">
                        Únete a la Comunidad
                    </MudText>
                    <MudText Typo="Typo.body2" Class="mb-3" Style="color: #94a3b8;">
                        Recibe nuevas rutas y promociones exclusivas en tu correo.
                    </MudText>
                    <div class="d-flex gap-2">
                        <MudTextField @bind-Value="_newsletterEmail"
                                      Placeholder="tu@correo.com"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="exploreway-footer-input" />
                        <MudButton Variant="Variant.Filled"
                                   Style="background: #00A86B; color: white;"
                                   OnClick="SuscribirNewsletter">
                            Enviar
                        </MudButton>
                    </div>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-8" Style="background-color: rgba(255,255,255,0.12);" />

            <div class="d-flex flex-column flex-sm-row justify-space-between align-center gap-3">
                <MudText Typo="Typo.caption" Style="color: #94a3b8;">
                    © @DateTime.Now.Year ExploreWay. Todos los derechos reservados.
                </MudText>
                <div class="d-flex gap-4">
                    <a href="#terminos" class="exploreway-sublink">Términos</a>
                    <a href="#privacidad" class="exploreway-sublink">Privacidad</a>
                    <a href="#soporte" class="exploreway-sublink">Soporte</a>
                </div>
            </div>
        </MudContainer>
    </footer>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private bool _menuAbierto;

    // El menú de usuario usa un popover propio: el MudMenu con ActivatorContent no abre con clic en esta versión de MudBlazor.
    private void AlternarMenu() => _menuAbierto = !_menuAbierto;

    private void CerrarMenu() => _menuAbierto = false;

    private void AlPulsarTecla(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") _menuAbierto = !_menuAbierto;
        else if (e.Key == "Escape") _menuAbierto = false;
    }

    protected override void OnInitialized() => Sesion.FotoCambiada += AlCambiarFoto;

    private void AlCambiarFoto() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Sesion.FotoCambiada -= AlCambiarFoto;
    private string _newsletterEmail = "";

    private string Iniciales =>
        string.Concat(Sesion.NombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(p => char.ToUpper(p[0])));

    // Abre el mismo diálogo del perfil del cliente (datos + foto) desde cualquier página.
    private async Task EditarPerfilAsync()
    {
        _drawerOpen = false;
        _menuAbierto = false;

        try
        {
            var cliente = await ClienteService.ObtenerMiPerfilAsync();
            if (cliente is null) return;

            var foto = !string.IsNullOrWhiteSpace(cliente.Foto) ? cliente.Foto
                : FotosLocal.Obtener(cliente.IdPersona) ?? Sesion.Foto;

            var parametros = new DialogParameters<ExploreWayApp.Components.Pages.Cliente.ClientePerfilDialogo>
            {
                { x => x.Cliente, cliente },
                { x => x.FotoActual, foto }
            };
            var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

            var dialogo = await Dialogos.ShowAsync<ExploreWayApp.Components.Pages.Cliente.ClientePerfilDialogo>(null, parametros, opciones);
            var resultado = await dialogo.Result;
            if (resultado is not null && !resultado.Canceled)
            {
                Snackbar.Add("Perfil actualizado.", Severity.Success);
                // Si está en su perfil, se recarga para mostrar los datos nuevos.
                if (NavManager.Uri.Contains("/cliente/perfil")) NavManager.Refresh();
            }
        }
        catch (ExploreWayApp.Excepciones.ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("No se pudo conectar con el servidor.", Severity.Error);
        }
    }

    private void CerrarSesion()
    {
        _drawerOpen = false;
        _menuAbierto = false;
        AuthService.CerrarSesion();
        Snackbar.Add("Sesión cerrada.", Severity.Info);
        NavManager.NavigateTo("/");
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }

    private void IrALogin()
    {
        _drawerOpen = false;
        NavManager.NavigateTo("/login");
    }

    private void AbrirModalRegistro()
    {
        _drawerOpen = false;
        NavManager.NavigateTo("/registro");
    }

    private void SuscribirNewsletter()
    {
        if (string.IsNullOrWhiteSpace(_newsletterEmail) || !_newsletterEmail.Contains("@"))
        {
            Snackbar.Add("Por favor, ingresa un correo electrónico válido.", Severity.Warning);
            return;
        }

        Snackbar.Add($"¡Gracias por unirte a ExploreWay! Hemos registrado {_newsletterEmail}.", Severity.Success);
        _newsletterEmail = "";
    }
}
